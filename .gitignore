# Python venv
.venv/
__pycache__/
*.pyc

# Large competition data (re-downloadable via gcp_setup.sh / kaggle CLI)
competition_data/snapshots/
competition_data/embeddings/
competition_data/graphs/
competition_data/wheels/
wheelhouse/

# Model weights (re-downloadable from Kaggle models)
# Note: this excludes the ~22GB base model only — small LoRA adapter
# .safetensors files under sample_submission/adapters/ are NOT matched
# by this pattern and are tracked intentionally (part of the submission).
/model/
model/*.safetensors

# Large archives
*.zip
!submission_build/submission.zip

# Eval traces/logs (can be large, regenerate by re-running)
results/*/traces/
results/*/test_outputs/
results/*/logs/

# OS
.DS_Store
