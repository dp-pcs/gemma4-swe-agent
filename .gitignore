# Python venv
.venv/
__pycache__/
*.pyc

# Large competition data (re-downloadable via gcp_setup.sh / kaggle CLI)
competition_data/snapshots/
competition_data/embeddings/
competition_data/graphs/
competition_data/wheels/
wheelhouse/

# Model weights (re-downloadable from Kaggle models)
# Note: this excludes the ~22GB base model only — small LoRA adapter
# .safetensors files under sample_submission/adapters/ are NOT matched
# by this pattern and are tracked intentionally (part of the submission).
/model/
model/*.safetensors

# Large archives
*.zip
!submission_build/submission.zip

# Eval traces/logs (can be large, regenerate by re-running)
results/*/traces/
results/*/test_outputs/
results/*/logs/

# OS
.DS_Store

# Large reproduction binaries inside results/ (regenerate from Kaggle wheelhouse + Dockerfile)
results/**/deployment.tar
results/**/*_wheels.tar
results/**/wheel_supplement.tar
results/**/sandbox_image.tar
results/**/wheelhouse/
results/**/runtime_wheels/
results/**/*.tgz
results/**/*.whl
results/**/snapshots/
results/**/tokenizer.json

# LoRA adapter weights are stored out of git (VM disk snapshot / GCS), configs are kept
results/**/adapter_model.safetensors
submission_build/**/adapter_model.safetensors
