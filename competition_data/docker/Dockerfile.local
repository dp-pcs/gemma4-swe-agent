# Local-dev extension of the public sandbox image.
# Adds test-only dependencies that are withheld from the public wheels cache
# (part of Kaggle's private grading data) so we can get a realistic pytest
# signal locally. NOT representative of the real competition sandbox exactly,
# but close enough for local iteration before uploading to Kaggle.
FROM swebench-sandbox:latest

RUN pip install --no-cache-dir \
    pytest-httpbin==2.0.0 \
    "httpbin~=0.10.0" \
    trustme \
    pytest-cov \
    pytest-mock
