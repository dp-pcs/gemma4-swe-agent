+def is_typealiastype(tp: Any) -> bool:
+    try:
+        from typing import TypeAliasType
+        return isinstance(tp, TypeAliasType)
+    except ImportError:
+        return False
+
+def resolve_type_alias(tp: Any) -> Any:
+    while is_typealiastype(tp):
+        tp = getattr(tp, "__value__", tp)
+    return tp
