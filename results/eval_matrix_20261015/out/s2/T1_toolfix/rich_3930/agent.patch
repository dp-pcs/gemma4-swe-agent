+def split_cells(text: str) -> list[str]:
+    """Split text into a list of grapheme clusters."""
+    clusters = []
+    current_cluster = ""
+    for char in text:
+        if current_cluster and (
+            unicodedata.category(char).startswith("M")
+            or char == "\u200d"
+            or 0x1F3FB <= ord(char) <= 0x1F3FF
+            or 0xFE00 <= ord(char) <= 0xFE0F
+        ):
+            current_cluster += char
+        else:
+            if current_cluster:
+                clusters.append(current_cluster)
+            current_cluster = char
+    if current_cluster:
+        clusters.append(current_cluster)
+    return clusters
+
