+def is_async_callable(obj: Any) -> bool:
+    curr = obj
+    while True:
+        curr = inspect.unwrap(curr)
+        if inspect.isroutine(curr):
+            if iscoroutinefunction(curr):
+                return True
+        elif not inspect.isclass(curr):
+            dunder_call = getattr(curr, "__call__", None)
+            if iscoroutinefunction(dunder_call):
+                return True
+        
+        if isinstance(curr, partial):
+            curr = curr.func
+        else:
+            break
+    return False
+
