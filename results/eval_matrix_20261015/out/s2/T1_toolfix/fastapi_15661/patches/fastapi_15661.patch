@@ -0,0 +1,66 @@
+import re
+import subprocess
+import sys
+from pathlib import Path
+
+import typer
+
+app = typer.Typer()
+
+VERSION_FILE = Path("fastapi/__init__.py")
+RELEASE_NOTES_FILE = Path("docs/en/docs/release-notes.md")
+
+@app.command()
+def main(version: str):
+    """
+    Prepare a new release.
+    
+    1. Update version in fastapi/__init__.py
+    2. Move content from '## Latest Changes' to a new version section in release notes.
+    3. Add the release date to the new version section.
+    """
+    # 1. Update version in fastapi/__init__.py
+    content = VERSION_FILE.read_text()
+    new_content = re.sub(r'__version__ = ".*"', f'__version__ = "{version}"', content)
+    VERSION_FILE.write_text(new_content)
+    typer.echo(f"Updated version to {version} in {VERSION_FILE}")
+    
+    # 2. Update release notes
+    full_text = RELEASE_NOTES_FILE.read_text()
+    
+    # Find ## Latest Changes and the first version header
+    # We use a regex that captures the header and the content until the next version header.
+    # The pattern looks for "## Latest Changes\n\n" followed by anything (non-greedy) 
+    # until it hits "\n## \d+\.\d+\.\d+".
+    
+    pattern = r"(## Latest Changes\n\n)(.*?)(?=\n## \d+\.\d+\.\d+)"
+    match = re.search(pattern, full_text, re.DOTALL)
+    
+    if not match:
+        typer.echo("Could not find '## Latest Changes' section with a following version header in release notes.")
+        raise typer.Exit(code=1)
+        
+    header = match.group(1)
+    latest_changes_content = match.group(2)
+    
+    # Construct the replacement:
+    # Keep the "## Latest Changes\n\n" header, then add the new version header, 
+    # then the content, then a couple of newlines.
+    replacement = f"{header}## {version}\n\n{latest_changes_content}\n\n"
+    
+    # Replace the matched part with the replacement
+    new_full_text = full_text[:match.start()] + replacement + full_text[match.end():]
+    RELEASE_NOTES_FILE.write_text(new_full_text)
+    typer.echo(f"Updated {RELEASE_NOTES_FILE} with new version {version}")
+    
+    # 3. Add the release date
+    # We call the existing script scripts/add_latest_release_date.py
+    try:
+        subprocess.run([sys.executable, "scripts/add_latest_release_date.py"], check=True)
+        typer.echo("Added release date to the new version section.")
+    except subprocess.CalledProcessError as e:
+        typer.echo(f"Error adding release date: {e}")
+        raise typer.Exit(code=1)
+
+if __name__ == "__main__":
+    app()
