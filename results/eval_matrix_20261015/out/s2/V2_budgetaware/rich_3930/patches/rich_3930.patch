+def split_graphemes(text: str) -> list[str]:
+    """Split a string into a list of grapheme clusters."""
+    graphemes: list[str] = []
+    for char in text:
+        if not graphemes:
+            graphemes.append(char)
+            continue
+
+        prev_char = graphemes[-1][-1]
+        # If current char is a combining mark or ZWJ, append it to the last grapheme
+        if unicodedata.combining(char) or char == "\u200D":
+            graphemes[-1] += char
+        # If previous char was a ZWJ, append current char to the last grapheme
+        elif prev_char == "\u200D":
+            graphemes[-1] += char
+        else:
+            graphemes.append(char)
+    return graphemes
+
 
