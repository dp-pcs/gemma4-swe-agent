@@ -10,6 +10,34 @@ from starlette.responses import Response as Response  # noqa
 from starlette.responses import StreamingResponse as StreamingResponse  # noqa
 from typing_extensions import deprecated
 
+
+class SSEResponse(StreamingResponse):
+    """SSE response for Server-Sent Events.
+
+    **Note**: `SSEResponse` is a subclass of `StreamingResponse` with the
+    `media_type` set to `text/event-stream` and default headers for SSE.
+    """
+
+    def __init__(
+        self,
+        content: Any,
+        status_code: int = 200,
+        headers: dict[str, str] | None = None,
+        background: Any = None,
+    ) -> None:
+        if headers is None:
+            headers = {}
+        headers.setdefault("Cache-Control", "no-cache")
+        headers.setdefault("Connection", "keep-alive")
+        super().__init__(
+            content=content,
+            status_code=status_code,
+            headers=headers,
+            background=background,
+            media_type="text/event-stream",
+        )
+
