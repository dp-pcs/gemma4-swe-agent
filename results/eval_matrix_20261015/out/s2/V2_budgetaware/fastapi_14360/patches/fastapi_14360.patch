@@ -0,0 +1,72 @@
+
+from fastapi import FastAPI, Query, Header, Cookie
+from fastapi.testclient import TestClient
+from pydantic import BaseModel, Field
+
+app = FastAPI()
+
+class QueryModel(BaseModel):
+    q: str = Field(..., alias="query-param")
+
+@app.get("/query")
+async def read_query(params: QueryModel = Query()):
+    return params
+
+class HeaderModel(BaseModel):
+    h: str = Field(..., alias="header-param")
+
+@app.get("/header")
+async def read_header(params: HeaderModel = Header()):
+    return params
+
+class CookieModel(BaseModel):
+    c: str = Field(..., alias="cookie-param")
+
+@app.get("/cookie")
+async def read_cookie(params: CookieModel = Cookie()):
+    return params
+
+client = TestClient(app)
+
+def test_query_alias():
+    # Test 1: Value extracted by alias, should be put into values with alias
+    # If it's put with name 'q', Pydantic validation will fail because it expects 'query-param'
+    response = client.get("/query", params={"query-param": "hello"})
+    print(f"Response status: {response.status_code}")
+    print(f"Response body: {response.json()}")
+    assert response.status_code == 200
+    assert response.json() == {"query-param": "hello"}
+
+    # Test 2: Value passed by name should be treated as extra
+    # If we pass 'q', it should be in the 'input' of the validation error.
+    response = client.get("/query", params={"q": "hello"})
+    print(f"Response status (by name): {response.status_code}")
+    print(f"Response body (by name): {response.json()}")
+    assert response.status_code == 422
+    # The 'input' should contain 'q'
+    assert response.json()['detail'][0]['input'] == {"q": "hello"}
+
+
+def test_header_alias():
+    response = client.get("/header", headers={"header-param": "hello"})
+    assert response.status_code == 200
+    assert response.json() == {"header-param": "hello"}
+
+def test_cookie_alias():
+    response = client.get("/cookie", cookies={"cookie-param": "hello"})
+    assert response.status_code == 200
+    assert response.json() == {"cookie-param": "hello"}
+
+if __name__ == "__main__":
+    try:
+        test_query_alias()
+        print("test_query_alias passed")
+        test_header_alias()
+        print("test_header_alias passed")
+        test_cookie_alias()
+        print("test_cookie_alias passed")
+    except Exception as e:
+        print(f"Test failed: {e}")
+        import traceback
+        traceback.print_exc()
+        exit(1)
