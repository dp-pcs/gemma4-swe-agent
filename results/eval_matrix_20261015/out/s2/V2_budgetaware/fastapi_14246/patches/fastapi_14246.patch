@@ -0,0 +1,25 @@
+
+from fastapi import FastAPI
+from pydantic import BaseModel, Field
+from fastapi.openapi.utils import get_openapi
+
+app = FastAPI()
+
+class NestedModel(BaseModel):
+    name: str = Field(serialization_alias="name_out")
+
+class MainModel(BaseModel):
+    nested: NestedModel
+    value: int = Field(serialization_alias="value_out")
+
+@app.post("/test")
+def test(item: MainModel):
+    return item
+
+openapi_schema = get_openapi(
+    title="Test",
+    version="0.1.0",
+    routes=app.routes,
+    separate_input_output_schemas=True
+)
+print(openapi_schema["components"]["schemas"].keys())
