@@ -0,0 +1,13 @@
+from typing import Annotated
+from pydantic import BaseModel, Json
+from pydantic.fields import FieldInfo
+
+class MyModel(BaseModel):
+    tags: Json[list[str]]
+
+field_info = MyModel.model_fields['tags']
+print(f"Annotation: {field_info.annotation}")
+if hasattr(field_info.annotation, "__origin__"):
+    print(f"Origin: {field_info.annotation.__origin__}")
+else:
+    print("No __origin__")
