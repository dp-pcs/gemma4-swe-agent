+from typing import Annotated
+from pydantic import BaseModel, Json
+from fastapi import FastAPI, Form
+from fastapi.dependencies.utils import _get_multidict_value
+from pydantic._internal import ModelField # This might be different in Pydantic v2
+import pprint
+
+# We need to simulate how FastAPI creates the ModelField
+# In FastAPI, ModelField is often a Pydantic ModelField (v1) or a wrapper (v2)
+
+# Let's just try to find where ModelField is defined in fastapi/dependencies/utils.py
+# It's imported from pydantic.
+
+# Let's try to inspect a field from a model
+class MyModel(BaseModel):
+    tags: Json[list[str]]
+
+field = MyModel.model_fields['tags']
+print("Field info:")
+pprint.pprint(field)
+if hasattr(field, 'metadata'):
+    print("Metadata:")
+    pprint.pprint(field.metadata)
+else:
+    print("No metadata attribute")
