+def _is_async_callable(call: Any, check_fn: Callable[[Any], bool]) -> bool:
+    while True:
+        if check_fn(call):
+            return True
+        if isinstance(call, partial):
+            call = call.func
+        elif hasattr(call, "__wrapped__"):
+            call = call.__wrapped__
+        else:
+            dunder_call = getattr(call, "__call__", None)
+            if dunder_call and check_fn(dunder_call):
+                return True
+            break
+    return False
