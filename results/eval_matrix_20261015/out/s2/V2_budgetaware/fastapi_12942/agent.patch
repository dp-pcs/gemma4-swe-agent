@@ -0,0 +1,19 @@
+from typing import Annotated, Union, Type, Any
+from typing_extensions import get_args, get_origin
+from pydantic import BaseModel
+from fastapi._compat import field_annotation_is_complex
+
+class ApplePie(BaseModel):
+    name: str = "Apple Pie"
+
+# Case 1: Simple BaseModel
+print(f"BaseModel: {field_annotation_is_complex(ApplePie)}")
+
+# Case 2: Annotated[BaseModel, ...]
+print(f"Annotated[BaseModel]: {field_annotation_is_complex(Annotated[ApplePie, 'tag'])}")
+
+# Case 3: Union[Annotated[BaseModel, ...], Annotated[BaseModel, ...]]
+print(f"Union[Annotated]: {field_annotation_is_complex(Union[Annotated[ApplePie, 'apple'], Annotated[ApplePie, 'pumpkin']])}")
+
+# Case 4: Annotated[Union[Annotated[BaseModel, ...], ...], ...]
+print(f"Annotated[Union[Annotated]]: {field_annotation_is_complex(Annotated[Union[Annotated[ApplePie, 'apple'], Annotated[ApplePie, 'pumpkin']], 'discriminator'])}")
