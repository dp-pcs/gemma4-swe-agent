@@ -0,0 +1,23 @@
+from fastapi import FastAPI, Depends, Security
+from fastapi.security import OAuth2PasswordBearer
+from fastapi.openapi.utils import get_openapi
+
+app = FastAPI()
+oauth2_scheme = OAuth2PasswordBearer(tokenUrl="token")
+
+def dep_with_scopes(token: str = Security(oauth2_scheme)):
+    return token
+
+# Path operation 1: depends on dep_with_scopes with scopes
+@app.get("/with_scopes", dependencies=[Security(dep_with_scopes, scopes=["scope1"])])
+def read_with_scopes():
+    return {"message": "with scopes"}
+
+# Path operation 2: depends on dep_with_scopes without scopes
+@app.get("/without_scopes", dependencies=[Depends(dep_with_scopes)])
+def read_without_scopes():
+    return {"message": "without scopes"}
+
+openapi_schema = get_openapi(routes=app.routes, title="Test App", version="1.0.0")
+import json
+print(json.dumps(openapi_schema, indent=2))
