+"""Automate release preparation."""
+
+import subprocess
+import sys
+import re
+from pathlib import Path
+
+def main() -> None:
+    if len(sys.argv) < 2:
+        print("Usage: python scripts/release.py <version>")
+        sys.exit(1)
+
+    version = sys.argv[1]
+
+    # 1. Update version in fastapi/__init__.py
+    init_file = Path("fastapi/__init__.py")
+    content = init_file.read_text()
+    new_content = re.sub(r'__version__ = ".*"', f'__version__ = "{version}"', content)
+    init_file.write_text(new_content)
+    print(f"Updated version to {version} in {init_file}")
+
+    # 2. Run scripts/add_latest_release_date.py
+    subprocess.run([sys.executable, "scripts/add_latest_release_date.py"], check=True)
+    print("Ran scripts/add_latest_release_date.py")
+
+    # 3. Run scripts/format.sh
+    subprocess.run(["bash", "scripts/format.sh"], check=True)
+    print("Ran scripts/format.sh")
+
+    # 4. Run scripts/lint.sh
+    subprocess.run(["bash", "scripts/lint.sh"], check=True)
+    print("Ran scripts/lint.sh")
+
+    # 5. Run scripts/test.sh
+    subprocess.run(["bash", "scripts/test.sh"], check=True)
+    print("Ran scripts/test.sh")
+
+if __name__ == "__main__":
+    main()
