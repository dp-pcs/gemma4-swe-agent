+from fastapi import FastAPI, Security, Depends
+from fastapi.security import OAuth2PasswordBearer
+from fastapi.openapi.utils import get_openapi
+
+app = FastAPI()
+
+scheme1 = OAuth2PasswordBearer(tokenUrl="token", scopes={"read": "Read"})
+scheme2 = OAuth2PasswordBearer(tokenUrl="token", scopes={"write": "Write"})
+
+@app.get("/read")
+async def read(token: str = Security(scheme1, scopes=["read"])):
+    return {"message": "read"}
+
+@app.get("/write")
+async def write(token: str = Security(scheme2, scopes=["write"])):
+    return {"message": "write"}
+
+openapi_schema = get_openapi(title="Test", version="1.0.0", routes=app.routes)
+import json
+print(json.dumps(openapi_schema, indent=2))
