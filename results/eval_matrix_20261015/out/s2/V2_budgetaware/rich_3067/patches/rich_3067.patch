--- /dev/null
+++ b/verify_url.py
@@ -0,0 +1,32 @@
+from rich.highlighter import ReprHighlighter
+from rich.text import Text
+
+def test_url_highlighting():
+    highlighter = ReprHighlighter()
+    
+    urls = [
+        "https://example.com/user",
+        "https://example.com/~user",
+        "http://example.com/~user/profile",
+        "file:///home/user/~test",
+        "wss://example.com/~socket",
+    ]
+    
+    for url in urls:
+        text = Text(url)
+        highlighter(text)
+        # Check if there is at least one span that covers the URL
+        # For ReprHighlighter, the style is usually 'repr.url' or similar
+        # But we just need to see if any span was created.
+        assert len(text.spans) > 0, f"URL {url} was not highlighted"
+        # The first span should start at 0 and end at len(url)
+        span = text.spans[0]
+        assert span.start == 0 and span.end == len(url), f"URL {url} was not fully highlighted: {span.start}-{span.end}"
+
+if __name__ == "__main__":
+    try:
+        test_url_highlighting()
+        print("All tests passed!")
+    except AssertionError as e:
+        print(f"Test failed: {e}")
+        exit(1)
