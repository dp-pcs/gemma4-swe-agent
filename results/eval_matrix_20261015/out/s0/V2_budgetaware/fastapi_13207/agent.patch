--- /dev/null
+++ b/repro.py
@@ -0,0 +1,54 @@
+
+from fastapi import FastAPI
+from pydantic import BaseModel, Field, computed_field
+import json
+
+class Item(BaseModel):
+    name: str
+    secret: str = Field(exclude=True)
+    @computed_field
+    @property
+    def upper_name(self) -> str:
+        return self.name.upper()
+
+def test_openapi_schema(separate_input_output_schemas: bool):
+    app = FastAPI(separate_input_output_schemas=separate_input_output_schemas)
+
+    @app.get("/items", response_model=Item)
+    def read_item():
+        return Item(name="test", secret="shhh")
+
+    openapi_schema = app.openapi()
+    
+    # Find the Item schema in components/schemas
+    item_schema = openapi_schema["components"]["schemas"]["Item"]
+    
+    print(f"separate_input_output_schemas={separate_input_output_schemas}")
+    print(f"  'upper_name' in schema: {'upper_name' in item_schema['properties']}")
+    print(f"  'secret' in schema: {'secret' in item_schema['properties']}")
+    
+    assert 'upper_name' in item_schema['properties'], f"computed field 'upper_name' missing when separate_input_output_schemas={separate_input_output_schemas}"
+    if not separate_input_output_schemas:
+        # When separate_input_output_schemas=False, we now use mode='serialization', 
+        # so 'secret' (exclude=True) should be missing.
+        assert 'secret' not in item_schema['properties'], f"excluded field 'secret' should be missing when separate_input_output_schemas={separate_input_output_schemas}"
+    else:
+        # When separate_input_output_schemas=True, we have separate schemas.
+        # Wait, if separate_input_output_schemas=True, get_definitions generates both.
+        # But the Item schema in components/schemas might be the validation one or serialization one.
+        # Actually, if separate_input_output_schemas=True, Pydantic v2 creates two schemas: Item and Item-serialization (or similar).
+        # Let's see what happens.
+        pass
+
+if __name__ == "__main__":
+    try:
+        test_openapi_schema(separate_input_output_schemas=True)
+        print("Test with separate_input_output_schemas=True passed (or skipped assertions)")
+    except Exception as e:
+        print(f"Test with separate_input_output_schemas=True failed: {e}")
+
+    try:
+        test_openapi_schema(separate_input_output_schemas=False)
+        print("Test with separate_input_output_schemas=False passed")
+    except Exception as e:
+        print(f"Test with separate_input_output_schemas=False failed: {e}")
