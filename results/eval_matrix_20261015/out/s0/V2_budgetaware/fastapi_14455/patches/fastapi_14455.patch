+def merge_security_schemes(existing: Dict[str, Any], new: Dict[str, Any]) -> Dict[str, Any]:
+    for name, definition in new.items():
+        if name in existing:
+            existing_def = existing[name]
+            if existing_def.get("type") == "oauth2" and definition.get("type") == "oauth2":
+                existing_flows = existing_def.get("flows", {})
+                new_flows = definition.get("flows", {})
+                for flow_type, flow_def in new_flows.items():
+                    if flow_type in existing_flows:
+                        existing_flows[flow_type].setdefault("scopes", {}).update(
+                            flow_def.get("scopes", {})
+                        )
+                    else:
+                        existing_flows[flow_type] = flow_def
+            else:
+                existing[name] = definition
+        else:
+            existing[name] = definition
+    return existing
+
