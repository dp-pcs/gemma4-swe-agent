diff --git a/reproduce_issue.py b/reproduce_issue.py
new file mode 100644
index 000000000..8e507c41a
--- /dev/null
+++ b/reproduce_issue.py
@@ -0,0 +1,43 @@
+from fastapi import FastAPI, Header, Request
+from fastapi.testclient import TestClient
+
+app = FastAPI()
+
+@app.get("/")
+async def read_root(request: Request, x_my_header: str = Header(alias="X_My_Header")):
+    print(f"Received headers: {request.headers}")
+    return {"x_my_header": x_my_header}
+
+@app.get("/no_convert")
+async def read_root_no_convert(request: Request, x_my_header: str = Header(alias="X_My_Header", convert_underscores=False)):
+    print(f"Received headers: {request.headers}")
+    return {"x_my_header": x_my_header}
+
+client = TestClient(app)
+
+def test_underscored_header_rejected_by_default():
+    response = client.get("/", headers={"X_My_Header": "foo"})
+    print(f"Default (convert_underscores=True) - Status: {response.status_code}, Body: {response.json()}")
+    assert response.status_code == 422
+
+def test_underscored_header_accepted_when_disabled():
+    response = client.get("/no_convert", headers={"X_My_Header": "foo"})
+    print(f"Disabled (convert_underscores=False) - Status: {response.status_code}, Body: {response.json()}")
+    assert response.status_code == 200
+    assert response.json() == {"x_my_header": "foo"}
+
+def test_hyphenated_header_accepted_by_default():
+    response = client.get("/", headers={"X-My-Header": "foo"})
+    print(f"Default (convert_underscores=True) - Status: {response.status_code}, Body: {response.json()}")
+    assert response.status_code == 200
+    assert response.json() == {"x_my_header": "foo"}
+
+if __name__ == "__main__":
+    try:
+        test_underscored_header_rejected_by_default()
+        test_underscored_header_accepted_when_disabled()
+        test_hyphenated_header_accepted_by_default()
+        print("All tests passed!")
+    except AssertionError as e:
+        print(f"Test failed!")
+        raise e
