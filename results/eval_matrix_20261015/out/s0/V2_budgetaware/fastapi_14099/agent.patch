@@ -0,0 +1,41 @@
+
+import asyncio
+from typing import Dict
+from fastapi import Depends, FastAPI
+from fastapi.responses import StreamingResponse
+from httpx import AsyncClient, ASGITransport
+
+app = FastAPI()
+state = {"status": "not started"}
+
+async def get_state():
+    return state
+
+async def dependency(state: Dict[str, str] = Depends(get_state)):
+    state["status"] = "started"
+    try:
+        yield "dependency"
+    finally:
+        state["status"] = "finished"
+
+@app.get("/")
+async def root(dep = Depends(dependency)):
+    async def streamer():
+        print(f"Streaming chunk 1, state: {state['status']}")
+        yield "chunk 1"
+        await asyncio.sleep(0.1)
+        print(f"Streaming chunk 2, state: {state['status']}")
+        yield "chunk 2"
+    return StreamingResponse(streamer())
+
+async def test_streaming_response_dependency():
+    async with AsyncClient(transport=ASGITransport(app=app), base_url="http://test") as ac:
+        print(f"Before request: {state['status']}")
+        async with ac.stream("GET", "/") as response:
+            print(f"Response status: {response.status_code}")
+            async for chunk in response.aiter_bytes():
+                print(f"Received chunk: {chunk.decode()}, state: {state['status']}")
+        print(f"After request: {state['status']}")
+
+if __name__ == "__main__":
+    asyncio.run(test_streaming_response_dependency())
