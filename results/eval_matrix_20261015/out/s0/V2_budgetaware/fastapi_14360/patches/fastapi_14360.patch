@@ -0,0 +1,65 @@
+from fastapi import FastAPI, Query, Header, Cookie
+from fastapi.testclient import TestClient
+from pydantic import BaseModel, Field
+
+app = FastAPI()
+
+class QueryModel(BaseModel):
+    q: str = Field(alias="query_param")
+
+@app.get("/query")
+async def read_query(params: QueryModel = Query()):
+    return params
+
+class HeaderModel(BaseModel):
+    h: str = Field(alias="header_param")
+
+@app.get("/header")
+async def read_header(params: HeaderModel = Header()):
+    return params
+
+class CookieModel(BaseModel):
+    c: str = Field(alias="cookie_param")
+
+@app.get("/cookie")
+async def read_cookie(params: CookieModel = Cookie()):
+    return params
+
+client = TestClient(app)
+
+def test_query_alias():
+    # Test 1: Value extracted by alias, should be validated by alias
+    response = client.get("/query", params={"query_param": "hello"})
+    assert response.status_code == 200
+
+    # Test 2: Value passed by name should result in validation error, 
+    # and the name should be in the input of the error
+    response = client.get("/query", params={"q": "hello"})
+    assert response.status_code == 422
+    errors = response.json()["detail"]
+    # The error should be that 'query_param' is missing
+    assert any(err["loc"] == ["query", "query_param"] for err in errors)
+    # The 'q' parameter should be in the input of the error
+    # In Pydantic v2, the 'input' field of the error contains the input value
+    # for the field that failed validation. But here 'query_param' failed.
+    # However, if 'q' was passed, it should be in the input of the overall validation.
+    # Actually, for a missing field, 'input' might be the whole input dict.
+    for err in errors:
+        if err["loc"] == ["query", "query_param"]:
+            assert "q" in err["input"]
+
+def test_header_alias():
+    response = client.get("/header", headers={"header_param": "hello"})
+    assert response.status_code == 200
+    assert response.json() == {"h": "hello"}
+
+def test_cookie_alias():
+    response = client.get("/cookie", cookies={"cookie_param": "hello"})
+    assert response.status_code == 200
+    assert response.json() == {"c": "hello"}
+
+if __name__ == "__main__":
+    test_query_alias()
+    test_header_alias()
+    test_cookie_alias()
+    print("All tests passed!")
