+from pydantic import BaseModel, Field
+class Test(BaseModel):
+    a: str = Field(alias='b')
+
+f = Test.__fields__['a']
+print(f'name: {f.name}, alias: {f.alias}')
+
+class Test2(BaseModel):
+    a: str
+
+f2 = Test2.__fields__['a']
+print(f'name: {f2.name}, alias: {f2.alias}')
