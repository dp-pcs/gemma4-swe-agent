+from rich.live import Live
+from rich.console import Console
+from rich.panel import Panel
+
+console = Console(record=True)
+with Live(Panel("Line 1\nLine 2"), console=console) as live:
+    import time
+    time.sleep(0.1)
+    live.update(Panel("Line 1\nLine 2"))
+    time.sleep(0.1)
+    live.update("")
+    time.sleep(0.1)
+    live.update(Panel("Line 1\nLine 2"))
+    time.sleep(0.1)
+
+print(console.export_text())
