+import sys
+with open('rich/highlighter.py', 'r') as f:
+    content = f.read()
+old_str = 'r"(?P<url>(file|https|http|ws|wss)://[-0-9a-zA-Z$_+!`(),.?/;:&=%#~]*)",'
+new_str = 'r"(?P<url>(file|https|http|ws|wss)://[-0-9a-zA-Z$_+!`(),.?/;:&=%#~@]*)",'
+new_content = content.replace(old_str, new_str)
+with open('rich/highlighter.py', 'w') as f:
+    f.write(new_content)
