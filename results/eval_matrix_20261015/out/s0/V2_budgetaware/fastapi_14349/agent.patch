+from fastapi._compat.v2 import _replace_refs
+import pytest
+
+def test_replace_refs_with_ref_field():
+    schema = {
+        "type": "object",
+        "properties": {
+            "$ref": {"type": "string"}
+        }
+    }
+    old_name_to_new_name_map = {}
+    # This should not raise AttributeError
+    _replace_refs(schema=schema, old_name_to_new_name_map=old_name_to_new_name_map)
+
+if __name__ == "__main__":
+    try:
+        test_replace_refs_with_ref_field()
+        print("Success")
+    except Exception as e:
+        print(f"Error: {e}")
+        import traceback
+        traceback.print_exc()
