new file mode 100644
index 00000000..c4aebbb4
--- /dev/null
+++ b/reproduce_issue.py
@@ -0,0 +1,24 @@
+from fastapi import FastAPI
+from pydantic import BaseModel, Field
+from fastapi.openapi.utils import get_openapi
+
+app = FastAPI()
+
+class MyModel(BaseModel):
+    ref: str = Field(alias="$ref")
+
+@app.get("/")
+def read_root() -> MyModel:
+    return MyModel(ref="test")
+
+try:
+    get_openapi(
+        title="Test",
+        version="1.0.0",
+        routes=[app.routes[0]],
+    )
+    print("Success")
+except Exception as e:
+    print(f"Error: {e}")
+    import traceback
+    traceback.print_exc()
