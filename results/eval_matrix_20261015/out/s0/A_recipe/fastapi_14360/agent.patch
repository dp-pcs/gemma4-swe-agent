@@ -0,0 +1,40 @@
+from fastapi import FastAPI, Depends
+from fastapi.testclient import TestClient
+from pydantic import BaseModel, Field
+import json
+
+app = FastAPI()
+
+class QueryModel(BaseModel):
+    q: str = Field(..., alias="query-param")
+
+@app.get("/test")
+async def test_endpoint(params: QueryModel = Depends()):
+    return params
+
+client = TestClient(app)
+
+def test_alias_success():
+    response = client.get("/test", params={"query-param": "hello"})
+    print(f"Success test: status={response.status_code}, body={response.json()}")
+    assert response.status_code == 200
+    assert response.json() == {"q": "hello"}
+
+def test_alias_extra_param():
+    response = client.get("/test", params={"query-param": "hello", "q": "world"})
+    print(f"Extra param test: status={response.status_code}, body={response.json()}")
+    assert response.status_code == 422
+    assert "q" in response.text
+    print("Extra param test passed")
+
+if __name__ == "__main__":
+    try:
+        test_alias_success()
+        print("test_alias_success passed")
+        test_alias_extra_param()
+        print("test_alias_extra_param passed")
+    except AssertionError as e:
+        print(f"Assertion failed: {e}")
+    except Exception as e:
+        import traceback
+        traceback.print_exc()
