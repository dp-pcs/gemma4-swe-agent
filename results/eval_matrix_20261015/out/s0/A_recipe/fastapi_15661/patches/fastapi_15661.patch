+"""Automate release preparation by updating the version and release notes."""
+
+import argparse
+import re
+import subprocess
+import sys
+from pathlib import Path
+
+FASTAPI_INIT_FILE = "fastapi/__init__.py"
+RELEASE_NOTES_FILE = "docs/en/docs/release-notes.md"
+
+def update_version(new_version: str) -> None:
+    content = Path(FASTAPI_INIT_FILE).read_text()
+    new_content = re.sub(r'__version__ = "[^"]+"', f'__version__ = "{new_version}"', content)
+    Path(FASTAPI_INIT_FILE).write_text(new_content)
+    print(f"Updated version to {new_version} in {FASTAPI_INIT_FILE}")
+
+def add_release_header(new_version: str) -> None:
+    content = Path(RELEASE_NOTES_FILE).read_text()
+    if f"## {new_version}" in content:
+        print(f"Header for {new_version} already exists in {RELEASE_NOTES_FILE}")
+        return
+
+    lines = content.splitlines(keepends=True)
+    header_pattern = re.compile(r"^## \d+\.\d+\.\d+")
+    insert_index = -1
+    for i, line in enumerate(lines):
+        if header_pattern.match(line):
+            insert_index = i
+            break
+    
+    if insert_index == -1:
+        print("No existing version header found in release notes. Appending to end.")
+        lines.append(f"\n## {new_version}\n")
+    else:
+        lines.insert(insert_index, f"## {new_version}\n")
+        print(f"Added header for {new_version} to {RELEASE_NOTES_FILE}")
+    
+    Path(RELEASE_NOTES_FILE).write_text("".join(lines))
+
+def main() -> None:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("version", help="The new version to set")
+    args = parser.parse_args()
+    
+    update_version(args.version)
+    add_release_header(args.version)
+    
+    print("Adding date to the latest release header...")
+    result = subprocess.run([sys.executable, "scripts/add_latest_release_date.py"])
+    if result.returncode != 0:
+        print("Failed to add date to the latest release header.")
+        sys.exit(result.returncode)
+
+if __name__ == "__main__":
+    main()
