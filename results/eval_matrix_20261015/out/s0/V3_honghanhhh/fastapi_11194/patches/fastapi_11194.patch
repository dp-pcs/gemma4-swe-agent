+from fastapi import FastAPI, File, Form, UploadFile
+from fastapi.testclient import TestClient
+from typing import List
+
+app = FastAPI()
+
+@app.post("/upload")
+async def upload(name: str = Form(...), files: List[UploadFile] = File(...)):
+    return {"name": name, "filenames": [f.filename for f in files]}
+
+client = TestClient(app)
+
+def test_form_then_files():
+    response = client.post(
+        "/upload",
+        data={"name": "test_name"},
+        files=[("files", ("file1.txt", b"content1")), ("files", ("file2.txt", b"content2"))]
+    )
+    print(f"Response: {response.status_code}, Body: {response.json()}")
+    assert response.status_code == 200
+
+if __name__ == "__main__":
+    try:
+        test_form_then_files()
+        print("Test passed!")
+    except Exception as e:
+        print(f"Test failed: {e}")
