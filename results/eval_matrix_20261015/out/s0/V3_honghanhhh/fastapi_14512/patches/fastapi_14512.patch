+from fastapi import FastAPI, Body
+from typing import Literal, Union, Annotated
+from pydantic import BaseModel, Field
+import json
+
+class Cat(BaseModel):
+    meow: bool
+    type: Literal["cat"]
+
+class Dog(BaseModel):
+    bark: bool
+    type: Literal["dog"]
+
+CatDog = Annotated[Union[Cat, Dog], Field(discriminator="type")]
+
+app = FastAPI()
+
+@app.post("/pet")
+async def create_pet(pet: Annotated[CatDog, Body()]):
+    return pet
+
+print(json.dumps(app.openapi(), indent=2))
