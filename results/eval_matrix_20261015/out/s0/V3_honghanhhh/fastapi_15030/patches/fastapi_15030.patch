@@ -82,3 +82,25 @@ class ORJSONResponse(JSONResponse):
         return orjson.dumps(
             content, option=orjson.OPT_NON_STR_KEYS | orjson.OPT_SERIALIZE_NUMPY
         )
+
+
+class SSEResponse(StreamingResponse):
+    """SSE response for Server-Sent Events.
+
+    This response class sets the `media_type` to `text/event-stream`.
+    """
+
+    def __init__(
+        self,
+        content: Any,
+        status_code: int = 200,
+        headers: Any = None,
+        background: Any = None,
+    ) -> None:
+        super().__init__(
+            content,
+            status_code=status_code,
+            headers=headers,
+            background=background,
+            media_type="text/event-stream",
+        )
