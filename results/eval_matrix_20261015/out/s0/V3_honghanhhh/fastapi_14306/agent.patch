diff --git a/fastapi/routing.py b/fastapi/routing.py
index c10175b1..9974e242 100644
--- a/fastapi/routing.py
+++ b/fastapi/routing.py
@@ -548,6 +548,22 @@ class APIRoute(routing.Route):
         self.summary = summary
         self.response_description = response_description
         self.deprecated = deprecated
+
+    @functools.cached_property
+    def endpoint_context(self) -> Optional[Dict[str, Any]]:
+        try:
+            file = inspect.getfile(self.endpoint)
+            lines, start_line = inspect.getsourcelines(self.endpoint)
+            return {
+                "file": file,
+                "line": start_line,
+                "name": self.name,
+                "method": list(self.methods),
+                "path": self.path,
+            }
+        except Exception:
+            return None
+
         self.operation_id = operation_id
