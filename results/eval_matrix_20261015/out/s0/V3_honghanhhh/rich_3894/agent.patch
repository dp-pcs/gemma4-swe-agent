+def _get_qualname(obj: Any, fallback: str = "") -> str:
+    """Get the qualified name of an object, with a fallback."""
+    qualname = getattr(obj, "__qualname__", fallback)
+    if not isinstance(qualname, str):
+        qualname = getattr(obj, "__name__", fallback)
+    if not isinstance(qualname, str):
+        qualname = fallback
+    return qualname
