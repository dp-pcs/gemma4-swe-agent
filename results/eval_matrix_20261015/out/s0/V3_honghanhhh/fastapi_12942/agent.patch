@@ -0,0 +1,62 @@
+from typing import Any, Literal, Annotated
+from pydantic import BaseModel
+from fastapi import FastAPI, Body
+from fastapi.testclient import TestClient
+
+class Pie(BaseModel):
+    time_to_cook: int
+    num_ingredients: int
+
+class ApplePie(Pie):
+    fruit: Literal["apple"] = "apple"
+
+class PumpkinPie(Pie):
+    filling: Literal["pumpkin"] = "pumpkin"
+
+def get_discriminator_value(v: Any) -> str:
+    if isinstance(v, dict):
+        return v.get("fruit", v.get("filling"))
+    return getattr(v, "fruit", getattr(v, "filling", None))
+
+# This is the problematic type
+# Note: Tag and Discriminator are from pydantic (or similar)
+# Wait, the issue says Tag and Discriminator. Let me check where they come from.
+# In Pydantic v2, Discriminator is in pydantic.
+# Tag is not a standard Pydantic thing, maybe it's just a marker?
+# Let's check the issue again.
+# "Annotated[ApplePie, Tag("apple")] | Annotated[PumpkinPie, Tag("pumpkin")]"
+# "Discriminator(get_discriminator_value)"
+# Actually, Pydantic v2 has Discriminator.
+# Let's try to use pydantic.Discriminator.
+
+from pydantic import Discriminator
+
+# I'll define a dummy Tag class since it's not imported in the example
+class Tag:
+    def __init__(self, value):
+        self.value = value
+
+Dessert = Annotated[
+    Annotated[ApplePie, Tag("apple")] | Annotated[PumpkinPie, Tag("pumpkin")],
+    Discriminator(get_discriminator_value),
+]
+
+app = FastAPI()
+@app.post("/dessert")
+async def dinner(dessert: Dessert) -> dict[str, Any]:
+    return dessert.model_dump()
+
+client = TestClient(app)
+
+def test_dessert():
+    # This should be a body parameter
+    response = client.post("/dessert", json={"fruit": "apple", "time_to_cook": 10, "num_ingredients": 3})
+    print(f"Response: {response.status_code}, {response.json()}")
+    assert response.status_code == 200
+
+if __name__ == "__main__":
+    try:
+        test_dessert()
+        print("Success!")
+    except Exception as e:
+        print(f"Error: {e}")
