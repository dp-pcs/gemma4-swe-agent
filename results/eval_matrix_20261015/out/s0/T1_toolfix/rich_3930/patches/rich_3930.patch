+def split_graphemes(text: str) -> list[str]:
+    """Split text into a list of graphemes."""
+    if not text:
+        return []
+
+    graphemes = []
+    current_grapheme = ""
+
+    for i, character in enumerate(text):
+        if i == 0:
+            current_grapheme = character
+            continue
+
+        prev_character = text[i - 1]
+        width = get_character_cell_size(character)
+
+        if width == 0 or prev_character == "\u200d":
+            current_grapheme += character
+        else:
+            graphemes.append(current_grapheme)
+            current_grapheme = character
+
+    if current_grapheme:
+        graphemes.append(current_grapheme)
+
+    return graphemes
