+def is_typealiastype(obj: Any) -> bool:
+    types_to_check = []
+    try:
+        from typing import TypeAliasType
+        types_to_check.append(TypeAliasType)
+    except ImportError:
+        pass
+    try:
+        from typing_extensions import TypeAliasType
+        types_to_check.append(TypeAliasType)
+    except ImportError:
+        pass
+    if not types_to_check:
+        return False
+    if sys.version_info[:2] == (3, 10) and type(obj) is types.GenericAlias:
+        return False
+    return isinstance(obj, tuple(types_to_check))
+
+
 def field_annotation_is_complex(annotation: Union[type[Any], None]) -> bool:
+    if is_typealiastype(annotation):
+        return field_annotation_is_complex(getattr(annotation, "__value__", None))
