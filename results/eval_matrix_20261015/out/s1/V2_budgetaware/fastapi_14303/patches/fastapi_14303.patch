diff --git a/reproduce_form.py b/reproduce_form.py
new file mode 100644
index 00000000..78612940
--- /dev/null
+++ b/reproduce_form.py
@@ -0,0 +1,31 @@
+from fastapi import FastAPI, Form
+from fastapi.testclient import TestClient
+from pydantic import BaseModel, ConfigDict
+
+app = FastAPI()
+
+class MyModel(BaseModel):
+    model_config = ConfigDict(extra="allow")
+    name: str
+
+@app.post("/test")
+async def test_endpoint(data: MyModel = Form(...)):
+    return data
+
+client = TestClient(app)
+
+def test_extra_form_params():
+    # 'name' is a regular param, 'extra' is an extra param with multiple values
+    response = client.post("/test", data={"name": "test", "extra": ["val1", "val2"]})
+    print(f"Response: {response.json()}")
+    assert response.status_code == 200
+    assert response.json()["extra"] == ["val1", "val2"]
+
+if __name__ == "__main__":
+    try:
+        test_extra_form_params()
+        print("Test passed!")
+    except AssertionError as e:
+        print(f"Test failed: {e}")
+    except Exception as e:
+        print(f"An error occurred: {e}")
diff --git a/reproduce_header.py b/reproduce_header.py
new file mode 100644
index 00000000..b97ae56b
--- /dev/null
+++ b/reproduce_header.py
@@ -0,0 +1,31 @@
+import httpx
+from fastapi import FastAPI, Header
+from pydantic import BaseModel, ConfigDict
+import asyncio
+
+app = FastAPI()
+
+class MyModel(BaseModel):
+    model_config = ConfigDict(extra="allow")
+    name: str
+
+@app.get("/test")
+async def test_endpoint(data: MyModel = Header(...)):
+    return data
+
+async def test_extra_header_params():
+    async with httpx.AsyncClient(transport=httpx.ASGITransport(app=app), base_url="http://test") as client:
+        # Send multiple headers with the same name 'extra'
+        response = await client.get("/test", headers=[("name", "test"), ("extra", "val1"), ("extra", "val2")])
+        print(f"Response: {response.json()}")
+        assert response.status_code == 200
+        assert response.json()["extra"] == ["val1", "val2"]
+
+if __name__ == "__main__":
+    try:
+        asyncio.run(test_extra_header_params())
+        print("Test passed!")
+    except AssertionError as e:
+        print(f"Test failed: {e}")
+    except Exception as e:
+        print(f"An error occurred: {e}")
