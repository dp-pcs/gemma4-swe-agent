diff --git a/pydantic_test_undefined.py b/pydantic_test_undefined.py
new file mode 100644
index 00000000..42ee77bf
--- /dev/null
+++ b/pydantic_test_undefined.py
@@ -0,0 +1,22 @@
+from pydantic import BaseModel, Field
+from pydantic.fields import FieldInfo
+from pydantic_core import PydanticUndefined
+
+class M1(BaseModel):
+    a: str = Field(alias='b')
+
+print(f'M1: {M1(b="val").model_dump()}')
+
+try:
+    class M2(BaseModel):
+        a: str = Field(alias='b', validation_alias=None)
+    print(f'M2: {M2(b="val").model_dump()}')
+except Exception as e:
+    print(f'M2 failed: {e}')
+
+try:
+    class M3(BaseModel):
+        a: str = Field(alias='b', validation_alias=PydanticUndefined)
+    print(f'M3: {M3(b="val").model_dump()}')
+except Exception as e:
+    print(f'M3 failed: {e}')
diff --git a/repro.py b/repro.py
new file mode 100644
index 00000000..2916ccbc
--- /dev/null
+++ b/repro.py
@@ -0,0 +1,27 @@
+from fastapi import FastAPI, Query
+from fastapi.testclient import TestClient
+
+app = FastAPI()
+
+@app.get("/")
+async def root(q: str = Query(validation_alias="q_alias")):
+    return {"q": q}
+
+client = TestClient(app)
+
+def test_validation_alias():
+    response = client.get("/", params={"q_alias": "hello"})
+    print(f"q_alias: {response.json()}")
+    assert response.status_code == 200
+    assert response.json() == {"q": "hello"}
+
+    response = client.get("/", params={"q": "hello"})
+    print(f"q: {response.json()}")
+    assert response.status_code == 422
+
+if __name__ == "__main__":
+    try:
+        test_validation_alias()
+        print("Test passed!")
+    except Exception as e:
+        print(f"Test failed: {e}")
