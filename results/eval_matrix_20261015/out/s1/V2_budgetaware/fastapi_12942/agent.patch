@@ -0,0 +1,41 @@
+from fastapi import FastAPI, Body
+from fastapi.dependencies import utils
+from typing import Annotated, Union
+from pydantic import BaseModel, Field
+from typing_extensions import Literal
+
+app = FastAPI()
+
+class T1(BaseModel):
+    tag: Literal["a"]
+    val1: str
+
+class T2(BaseModel):
+    tag: Literal["b"]
+    val2: int
+
+# This is the complex nested type described in the issue
+# Annotated[Annotated[T1, "tag_a"] | Annotated[T2, "tag_b"], "discriminator"]
+# In real FastAPI, Tag and Discriminator are just metadata in Annotated
+ComplexType = Annotated[
+    Union[Annotated[T1, "tag_a"], Annotated[T2, "tag_b"]],
+    "discriminator"
+]
+
+@app.post("/test")
+async def test_endpoint(param: ComplexType):
+    return param
+
+def test_is_complex():
+    # This is what FastAPI's analyze_param uses internally via field_annotation_is_complex
+    from fastapi._compat import field_annotation_is_complex
+    
+    print(f"Is ComplexType complex? {field_annotation_is_complex(ComplexType)}")
+    assert field_annotation_is_complex(ComplexType) is True
+
+if __name__ == "__main__":
+    try:
+        test_is_complex()
+        print("Test passed!")
+    except AssertionError:
+        print("Test failed!")
