@@ -0,0 +1,27 @@
+from fastapi import FastAPI, Response, Depends
+from typing import Annotated
+from fastapi.testclient import TestClient
+
+app = FastAPI()
+
+def modify_response():
+    return Response(content="modified", status_code=200)
+
+@app.get("/")
+def endpoint(response: Annotated[Response, Depends(modify_response)]):
+    return {"message": "hello"}
+
+client = TestClient(app)
+
+def test_response_dependency():
+    # If we reach here, the AssertionError during app creation/first request is gone
+    response = client.get("/")
+    assert response.status_code == 200
+
+if __name__ == "__main__":
+    try:
+        test_response_dependency()
+        print("Test passed!")
+    except Exception as e:
+        print(f"Test failed: {e}")
+        raise e
