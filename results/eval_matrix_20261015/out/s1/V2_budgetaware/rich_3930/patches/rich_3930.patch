+def split_graphemes(text: str) -> list[str]:
+    """Split text into grapheme clusters.
+
+    Args:
+        text (str): Text to split.
+
+    Returns:
+        list[str]: A list of grapheme clusters.
+    """
+    if not text:
+        return []
+
+    graphemes = []
+    current_grapheme = ""
+
+    for i, char in enumerate(text):
+        is_combining = unicodedata.category(char).startswith("M")
+        is_zwj = char == "\u200d"
+        prev_was_zwj = i > 0 and text[i - 1] == "\u200d"
+
+        if (is_combining or is_zwj or prev_was_zwj) and current_grapheme:
+            current_grapheme += char
+        else:
+            if current_grapheme:
+                graphemes.append(current_grapheme)
+            current_grapheme = char
+
+    if current_grapheme:
+        graphemes.append(current_grapheme)
+
+    return graphemes
+
+
+def get_grapheme_cell_size(grapheme: str) -> int:
+    """Get the cell size of a grapheme cluster.
+
+    Args:
+        grapheme (str): A grapheme cluster.
+
+    Returns:
+        int: Number of cells occupied by the grapheme cluster.
+    """
+    for char in grapheme:
+        width = get_character_cell_size(char)
+        if width > 0:
+            return width
+    return 0
+
