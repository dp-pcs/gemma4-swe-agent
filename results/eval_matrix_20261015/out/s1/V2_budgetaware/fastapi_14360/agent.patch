@@ -0,0 +1,44 @@
+from fastapi import FastAPI, Query, Depends
+from fastapi.testclient import TestClient
+from pydantic import BaseModel, Field
+
+app = FastAPI()
+
+class MyModel(BaseModel):
+    foo: str = Field(alias="foo_alias")
+
+@app.get("/")
+def read_root(params: MyModel = Depends()):
+    return params
+
+client = TestClient(app)
+
+def test_alias_extraction():
+    print("Testing alias extraction...")
+    response = client.get("/?foo_alias=bar")
+    print(f"Response: {response.json()}")
+    assert response.status_code == 200
+    assert response.json() == {"foo": "bar"}
+
+def test_name_extraction_error():
+    print("Testing name extraction error...")
+    # Passing by name should fail validation and show 'foo' in input
+    response = client.get("/?foo=bar")
+    print(f"Response: {response.json()}")
+    assert response.status_code == 422
+    # The error should indicate that 'foo_alias' is missing, 
+    # and 'foo' should be in the input of the error.
+    print(f"Error detail: {response.json()['detail']}")
+
+if __name__ == "__main__":
+    try:
+        test_alias_extraction()
+        print("test_alias_extraction passed")
+    except Exception as e:
+        print(f"test_alias_extraction failed: {e}")
+    
+    try:
+        test_name_extraction_error()
+        print("test_name_extraction_error passed")
+    except Exception as e:
+        print(f"test_name_extraction_error failed: {e}")
