index 00000000..d79acb4c
--- /dev/null
+++ b/repro_secret.py
@@ -0,0 +1,45 @@
+
+from fastapi import FastAPI
+from pydantic import BaseModel, computed_field, Field
+from fastapi.openapi.utils import get_openapi
+
+app = FastAPI()
+
+class Item(BaseModel):
+    name: str
+    secret: str = Field(exclude=True)
+    
+    @computed_field
+    @property
+    def description(self) -> str:
+        return f"Description of {self.name}"
+
+@app.post("/items", response_model=Item)
+def create_item(item: Item):
+    return item
+
+# Case 1: separate_input_output_schemas=True (default)
+openapi_true = get_openapi(
+    title="Test",
+    version="1.0.0",
+    routes=app.routes,
+    separate_input_output_schemas=True
+)
+
+# Case 2: separate_input_output_schemas=False
+openapi_false = get_openapi(
+    title="Test",
+    version="1.0.0",
+    routes=app.routes,
+    separate_input_output_schemas=False
+)
+
+print("--- separate_input_output_schemas=True ---")
+print("Schemas:", openapi_true["components"]["schemas"].keys())
+for schema_name, schema in openapi_true["components"]["schemas"].items():
+    print(f"{schema_name} properties: {schema['properties'].keys()}")
+
+print("\n--- separate_input_output_schemas=False ---")
+print("Schemas:", openapi_false["components"]["schemas"].keys())
+for schema_name, schema in openapi_false["components"]["schemas"].items():
+    print(f"{schema_name} properties: {schema['properties'].keys()}")
