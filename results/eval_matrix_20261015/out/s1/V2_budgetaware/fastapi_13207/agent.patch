+
+from fastapi import FastAPI
+from pydantic import BaseModel, computed_field
+from fastapi.openapi.utils import get_openapi
+
+app = FastAPI()
+
+class Item(BaseModel):
+    name: str
+    
+    @computed_field
+    @property
+    def description(self) -> str:
+        return f"Description of {self.name}"
+
+@app.get("/items", response_model=Item)
+def read_item():
+    return Item(name="test")
+
+# Case 1: separate_input_output_schemas=True (default)
+openapi_true = get_openapi(
+    title="Test",
+    version="1.0.0",
+    routes=app.routes,
+    separate_input_output_schemas=True
+)
+
+# Case 2: separate_input_output_schemas=False
+openapi_false = get_openapi(
+    title="Test",
+    version="1.0.0",
+    routes=app.routes,
+    separate_input_output_schemas=False
+)
+
+print("--- separate_input_output_schemas=True ---")
+print(openapi_true["components"]["schemas"]["Item"]["properties"].keys())
+
+print("\n--- separate_input_output_schemas=False ---")
+print(openapi_false["components"]["schemas"]["Item"]["properties"].keys())
