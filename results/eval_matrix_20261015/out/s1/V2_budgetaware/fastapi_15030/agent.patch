@@ -10,6 +10,30 @@ from starlette.responses import Response as Response  # noqa
 from starlette.responses import StreamingResponse as StreamingResponse  # noqa
 from typing_extensions import deprecated
 
+
+class SSEResponse(StreamingResponse):
+    """SSE response for Server Sent Events.
+
+    This response sets the `media_type` to `text/event-stream` and adds the
+    `Cache-Control: no-cache` and `Connection: keep-alive` headers.
+    """
+
+    def __init__(
+        self,
+        content,
+        status_code: int = 200,
+        headers: dict[str, str] | None = None,
+        background: Any = None,
+        media_type: str = "text/event-stream",
+    ):
+        if headers is None:
+            headers = {}
+        headers["Cache-Control"] = "no-cache"
+        headers["Connection"] = "keep-alive"
+        super().__init__(
+            content, status_code=status_code, headers=headers, background=background, media_type=media_type
+        )
+
