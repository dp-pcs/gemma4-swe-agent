diff --git a/update_sse_doc_v2.py b/update_sse_doc_v2.py
new file mode 100644
index 000000000..759ab2cb8
--- /dev/null
+++ b/update_sse_doc_v2.py
@@ -0,0 +1,10 @@
+
+with open('fastapi/sse.py', 'r') as f:
+    lines = f.readlines()
+
+for i in range(len(lines)):
+    if 'Must not contain null' in lines[i] and 'characters.**' in lines[i]:
+        lines[i] = lines[i].replace('Must not contain null (`\0`) characters.**', 'Must not contain null (`\0`) or newline characters.**')
+
+with open('fastapi/sse.py', 'w') as f:
+    f.writelines(lines)
