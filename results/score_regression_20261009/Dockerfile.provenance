FROM swebench-sandbox:local
COPY frozen_base_site_packages.tar /tmp/frozen_base_site_packages.tar
RUN tar -xf /tmp/frozen_base_site_packages.tar -C /usr/local/lib/python3.13/site-packages \
    && rm /tmp/frozen_base_site_packages.tar
# The organizer injects wheel files directly, bypassing pip constraints.
# Seed that exact layer first; its marker preserves these local compatibility pins.
RUN pip install --no-cache-dir --target=/opt/task-compatibility \
    starlette==0.48.0 \
    pydantic==2.12.5 \
    inline-snapshot==0.21.1 \
    dirty-equals==0.9.0 \
    python-multipart==0.0.20 \
    Pygments==2.13.0 \
    Flask==2.2.5 \
    Werkzeug==2.2.3
COPY regenerate_httpbin_certificates.py /opt/provenance-audit/regenerate_httpbin_certificates.py
RUN python /opt/provenance-audit/regenerate_httpbin_certificates.py
COPY container_provenance.py /opt/provenance-audit/container_provenance.py
ENV PYTHONPATH=/workspace/src:/workspace:/opt/task-compatibility:/opt/provenance-audit
ENV PYTEST_PLUGINS=container_provenance
