# Local CPU-control image only. Never replace an historical sandbox image tag.
ARG BASE_IMAGE
FROM ${BASE_IMAGE}
ARG PYGMENTS_VERSION=2.13.0
ARG SANDBOX_PROFILE=httpbin
RUN case "${SANDBOX_PROFILE}" in framework|httpbin) ;; *) echo "Invalid sandbox profile: ${SANDBOX_PROFILE}" >&2; exit 1 ;; esac
RUN apt-get update -qq \
    && apt-get install -y -qq --no-install-recommends git patch protobuf-compiler pigz \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /wheels /workspace /opt/provenance-audit \
    && printf '%s\n' "${SANDBOX_PROFILE}" > /opt/provenance-audit/sandbox-profile.txt
COPY sandbox_wheels/ /opt/sandbox-wheels/
COPY sandbox_requirements.lock /opt/sandbox-requirements.lock
RUN pip install --no-index --find-links=/opt/sandbox-wheels --require-hashes -r /opt/sandbox-requirements.lock \
    && pip freeze --all > /opt/provenance-audit/base-dependency-versions.txt
COPY imp.py telnetlib.py /usr/local/lib/python3.13/site-packages/
COPY frozen_base_site_packages.tar /tmp/frozen_base_site_packages.tar
RUN tar -xf /tmp/frozen_base_site_packages.tar -C /usr/local/lib/python3.13/site-packages \
    && test -f /usr/local/lib/python3.13/site-packages/.swegemma_base_injected \
    && rm /tmp/frozen_base_site_packages.tar
# SDK 0.2.11 still injects unpacked wheels without RECORD. Preserve the exact
# organizer marker, then install compatibility into a separate import layer.
COPY compatibility_requirements.lock /opt/compatibility-requirements.lock
RUN pip install --no-index --find-links=/opt/sandbox-wheels --require-hashes \
    --target=/opt/task-compatibility -r /opt/compatibility-requirements.lock \
    && pip list --path=/opt/task-compatibility --format=json > /opt/provenance-audit/compatibility-dependency-versions.json
ENV TEST_TMPDIR=/tmp
ENV PYTHONPATH=/workspace/src:/workspace:/opt/task-compatibility:/opt/provenance-audit
ENV PYTEST_PLUGINS=container_provenance
COPY regenerate_httpbin_certificates.py container_provenance.py tls_fixture_manifest.py /opt/provenance-audit/
RUN if [ "${SANDBOX_PROFILE}" = httpbin ]; then \
        python /opt/provenance-audit/tls_fixture_manifest.py original \
        && python /opt/provenance-audit/regenerate_httpbin_certificates.py \
        && python /opt/provenance-audit/tls_fixture_manifest.py regenerated; \
    fi \
    && git config --global user.email "agent@eval" \
    && git config --global user.name "Agent" \
    && git config --global init.defaultBranch main
LABEL local.control.pygments=${PYGMENTS_VERSION}
LABEL local.control.sandbox_profile=${SANDBOX_PROFILE}
WORKDIR /workspace
