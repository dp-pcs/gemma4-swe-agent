+++ b/fastapi/utils.py
@@ -258,3 +258,24 @@ def get_value_or_default(
         if not isinstance(item, DefaultPlaceholder):
             return item
     return first_item
+
+from functools import lru_cache
+from typing import Any, Optional
+import inspect
+
+from fastapi.dependencies.models import Dependant, _unwrapped_call
+
+@lru_cache(maxsize=None)
+def get_endpoint_context(dependant: Dependant, method: str) -> Optional[str]:
+    call = _unwrapped_call(dependant.call)
+    if call is None:
+        return None
+    try:
+        frame = inspect.getframeinfo(call)
+        filepath = frame.filename
+        lineno = frame.lineno
+        func_name = call.__name__
+        route = dependant.path or ""
+        return f"  File \"{filepath}\", line {lineno}, in {func_name}\n    {method} {route}"
+    except Exception:
+        return None
