+def split_graphemes(text: str) -> list[str]:
+    """Split text into graphemes."""
+    graphemes = []
+    for char in text:
+        if not graphemes:
+            graphemes.append(char)
+            continue
+
+        cp = ord(char)
+        if (
+            unicodedata.combining(char)
+            or char == "\u200d"
+            or (0x1F3FB <= cp <= 0x1F3FF)
+            or graphemes[-1][-1] == "\u200d"
+        ):
+            graphemes[-1] += char
+        else:
+            graphemes.append(char)
+    return graphemes
+
