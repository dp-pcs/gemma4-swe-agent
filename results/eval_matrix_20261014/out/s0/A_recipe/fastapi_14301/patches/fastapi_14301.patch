index 00000000..5b202862
--- /dev/null
+++ b/repro.py
@@ -0,0 +1,32 @@
+from fastapi import FastAPI, Depends
+from fastapi.testclient import TestClient
+
+app = FastAPI()
+counter = 0
+
+def dep():
+    global counter
+    counter += 1
+    return counter
+
+def dep_a(d = Depends(dep)):
+    return d
+
+def dep_b(d = Depends(dep)):
+    return d
+
+@app.get("/", dependencies=[Depends(dep, scope="function")])
+def read_root(a = Depends(dep_a), b = Depends(dep_b)):
+    return {"counter": counter}
+
+client = TestClient(app)
+
+def test_function_scope():
+    global counter
+    counter = 0
+    response = client.get("/")
+    print(f"Counter: {response.json()['counter']}")
+    assert response.json()["counter"] == 3
+
+if __name__ == "__main__":
+    test_function_scope()
