--- /dev/null
+++ b/reproduce_issue.py
@@ -0,0 +1,40 @@
+from typing import Literal, Union, Annotated
+from pydantic import BaseModel, Field
+from fastapi import FastAPI, Body
+from fastapi.testclient import TestClient
+
+class Cat(BaseModel):
+    meow: bool
+    kind: Literal["cat"]
+
+class Dog(BaseModel):
+    bark: bool
+    kind: Literal["dog"]
+
+app = FastAPI()
+
+@app.post("/pet")
+async def create_pet(pet: Annotated[Union[Cat, Dog], Field(discriminator="kind"), Body()]):
+    return pet
+
+client = TestClient(app)
+
+def test_tagged_union():
+    # Valid cat
+    response = client.post("/pet", json={"kind": "cat", "meow": True})
+    assert response.status_code == 200
+    assert response.json() == {"kind": "cat", "meow": True}
+
+    # Valid dog
+    response = client.post("/pet", json={"kind": "dog", "bark": True})
+    assert response.status_code == 200
+    assert response.json() == {"kind": "dog", "bark": True}
+
+if __name__ == "__main__":
+    try:
+        test_tagged_union()
+        print("Success!")
+    except Exception as e:
+        print(f"Failure: {e}")
+        import traceback
+        traceback.print_exc()
