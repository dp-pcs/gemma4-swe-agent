+"""Automate release preparation."""
+
+import re
+import sys
+import subprocess
+
+VERSION_FILE = "fastapi/__init__.py"
+RELEASE_NOTES_FILE = "docs/en/docs/release-notes.md"
+
+def update_version(new_version: str) -> None:
+    with open(VERSION_FILE, "r") as f:
+        content = f.read()
+    
+    new_content = re.sub(r'__version__ = ".*"', f'__version__ = "{new_version}"', content)
+    
+    with open(VERSION_FILE, "w") as f:
+        f.write(new_content)
+    print(f"Updated version to {new_version} in {VERSION_FILE}")
+
+def add_release_header(new_version: str) -> None:
+    with open(RELEASE_NOTES_FILE, "r") as f:
+        lines = f.readlines()
+    
+    # Find the first version header
+    version_header_pattern = re.compile(r"^## \d+\.\d+\.\d+")
+    insert_index = -1
+    for i, line in enumerate(lines):
+        if version_header_pattern.match(line):
+            insert_index = i
+            break
+    
+    if insert_index == -1:
+        print("Could not find any version header in release notes")
+        sys.exit(1)
+    
+    # Insert the new version header
+    lines.insert(insert_index, f"## {new_version}\n")
+    
+    with open(RELEASE_NOTES_FILE, "w") as f:
+        f.writelines(lines)
+    print(f"Added header ## {new_version} to {RELEASE_NOTES_FILE}")
+
+def main() -> None:
+    if len(sys.argv) < 2:
+        print("Usage: python scripts/release.py <new_version>")
+        sys.exit(1)
+    
+    new_version = sys.argv[1]
+    update_version(new_version)
+    add_release_header(new_version)
+    
+    # Run the add_latest_release_date script
+    subprocess.run([sys.executable, "scripts/add_latest_release_date.py"], check=True)
+
+if __name__ == "__main__":
+    main()
