+import argparse
+import subprocess
+import sys
+from pathlib import Path
+import re
+
+def main():
+    parser = argparse.ArgumentParser(description="Prepare FastAPI release")
+    parser.add_argument("version", help="The version to release (e.g. 0.136.4)")
+    args = parser.parse_args()
+
+    # Update version in fastapi/__init__.py
+    init_file = Path("fastapi/__init__.py")
+    content = init_file.read_text()
+    new_content = re.sub(r'__version__ = ".*"', f'__version__ = "{args.version}"', content)
+    init_file.write_text(new_content)
+    print(f"Updated version to {args.version} in {init_file}")
+
+    # Run add_latest_release_date.py
+    print("Updating release notes date...")
+    subprocess.run([sys.executable, "scripts/add_latest_release_date.py"], check=True)
+
+    # Run tests
+    print("Running tests...")
+    subprocess.run(["bash", "scripts/test.sh"], check=True)
+    print("Tests passed!")
+
+if __name__ == "__main__":
+    main()
