+#!/usr/bin/env python3
+import subprocess
+import sys
+
+def run_command(command: str):
+    print(f"Running: {command}")
+    result = subprocess.run(command, shell=True)
+    if result.returncode != 0:
+        print(f"Command failed with exit code {result.returncode}: {command}")
+        sys.exit(result.returncode)
+
+def main():
+    # 1. Format code
+    run_command("./scripts/format.sh")
+    # 2. Lint code
+    run_command("./scripts/lint.sh")
+    # 3. Run tests
+    run_command("./scripts/test.sh")
+    # 4. Add latest release date to release notes
+    run_command("python scripts/add_latest_release_date.py")
+    print("\nRelease preparation completed successfully!")
+
+if __name__ == "__main__":
+    main()
