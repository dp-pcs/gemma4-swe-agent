+def graphemes(text: str) -> Iterable[str]:
+    """Split a string into a sequence of graphemes."""
+    if not text:
+        return
+
+    current_grapheme = []
+    for char in text:
+        if current_grapheme and (unicodedata.combining(char) or current_grapheme[-1] == "\u200D" or char == "\u200D"):
+            current_grapheme.append(char)
+        else:
+            if current_grapheme:
+                yield "".join(current_grapheme)
+            current_grapheme = [char]
+    if current_grapheme:
+        yield "".join(current_grapheme)
+
