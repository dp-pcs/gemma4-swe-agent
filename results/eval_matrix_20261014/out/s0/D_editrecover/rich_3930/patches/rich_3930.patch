+def iter_graphemes(text: str) -> Iterable[str]:
+    """Yield graphemes from the text."""
+    if not text:
+        return
+
+    grapheme = ""
+    for char in text:
+        if grapheme and (unicodedata.combining(char) or char == "\u200d" or 0xfe00 <= ord(char) <= 0xfe0f):
+            grapheme += char
+        else:
+            if grapheme:
+                yield grapheme
+            grapheme = char
+    if grapheme:
+        yield grapheme
