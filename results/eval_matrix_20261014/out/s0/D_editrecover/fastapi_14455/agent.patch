+def _merge_security_definitions(
+    existing_definitions: Dict[str, Any],
+    new_definitions: Dict[str, Any],
+) -> None:
+    for security_name, security_definition in new_definitions.items():
+        if (
+            security_name in existing_definitions
+            and existing_definitions[security_name].get("type") == "oauth2"
+            and security_definition.get("type") == "oauth2"
+        ):
+            existing_flows = existing_definitions[security_name].setdefault("flows", {})
+            new_flows = security_definition.get("flows", {})
+            for flow_name, flow_details in new_flows.items():
+                if flow_name in existing_flows:
+                    existing_flow = existing_flows[flow_name]
+                    new_flow = flow_details
+                    if "scopes" in existing_flow and "scopes" in new_flow:
+                        existing_flow["scopes"].update(new_flow["scopes"])
+                    elif "scopes" in new_flow:
+                        existing_flow["scopes"] = new_flow["scopes"].copy()
+                else:
+                    existing_flows[flow_name] = flow_details
+        else:
+            existing_definitions[security_name] = security_definition
+
+
 def get_openapi_security_definitions(
