+"""Prepare release by updating version and release notes."""
+
+import re
+from pathlib import Path
+from typing import Annotated
+
+import typer
+
+app = typer.Typer()
+
+def update_version(version: str) -> None:
+    path = Path("fastapi/__init__.py")
+    content = path.read_text(encoding="utf-8")
+    new_content = re.sub(r'__version__ = "[^"]+"', f'__version__ = "{version}"', content)
+    path.write_text(new_content, encoding="utf-8")
+    print(f"Updated version to {version} in {path}")
+
+def update_release_notes(version: str) -> None:
+    path = Path("docs/en/docs/release-notes.md")
+    content = path.read_text(encoding="utf-8")
+    
+    latest_changes_marker = "## Latest Changes"
+    if latest_changes_marker not in content:
+        print(f"Could not find {latest_changes_marker} in {path}")
+        return
+
+    version_header_match = re.search(r"## \d+\.\d+\.\d+", content)
+    latest_changes_start = content.find(latest_changes_marker)
+    line_end = content.find("\n", latest_changes_start)
+    if line_end == -1:
+        line_end = len(content)
+
+    if version_header_match:
+        version_header_start = version_header_match.start()
+        content_to_move = content[line_end + 1 : version_header_start].strip()
+        prefix = content[:line_end + 1].rstrip()
+        suffix = content[version_header_start:]
+        new_content = f"{prefix}\n\n## {version}\n\n{content_to_move}\n\n{suffix}"
+    else:
+        content_to_move = content[line_end + 1 :].strip()
+        prefix = content[:line_end + 1].rstrip()
+        new_content = f"{prefix}\n\n## {version}\n\n{content_to_move}"
+
+    if not content_to_move:
+        print("No changes to move from Latest Changes section.")
+        return
+
+    path.write_text(new_content, encoding="utf-8")
+    print(f"Updated release notes with version {version} in {path}")
+
+@app.command()
+def main(version: Annotated[str, typer.Argument(help="The new version to set")]) -> None:
+    update_version(version)
+    update_release_notes(version)
+
+if __name__ == "__main__":
+    app()
