new file mode 100644
index 00000000..61ada51c
--- /dev/null
+++ b/reproduce_issue.py
@@ -0,0 +1,25 @@
+import requests
+
+# S3 presigned URL with key starting with '/'
+url = "https://bucket.s3.amazonaws.com//key_with_leading_slash.txt"
+# We want to see what request_url returns. 
+# Since request_url is internal to HTTPAdapter, we can mock the session or just use a real request 
+# and see if it fails or if we can inspect the prepared request.
+
+# Actually, the easiest way to verify this is to use a mock adapter or just check the behavior.
+# But the problem statement says "URLs like https://bucket.s3.amazonaws.com//key_name now correctly preserve //key_name in the path."
+
+# Let's try to reproduce it by creating a session and a request.
+session = requests.Session()
+req = requests.Request('GET', url)
+prepared = session.prepare_request(req)
+adapter = session.get_adapter('https://')
+# Call request_url directly
+final_url = adapter.request_url(prepared, session.proxies)
+print(f"Final URL: {final_url}")
+
+expected = "//key_with_leading_slash.txt"
+if final_url == expected:
+    print("SUCCESS")
+else:
+    print(f"FAILURE: Expected {expected}, got {final_url}")
