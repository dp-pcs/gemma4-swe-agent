new file mode 100644
index 00000000..55c04910
--- /dev/null
+++ b/reproduce_bug.py
@@ -0,0 +1,30 @@
+from requests.utils import should_bypass_proxies
+
+def test_no_proxy_boundary():
+    # Case 1: Exact match
+    assert should_bypass_proxies("http://example.com/", "example.com") is True
+    
+    # Case 2: Subdomain match
+    assert should_bypass_proxies("http://sub.example.com/", "example.com") is True
+    
+    # Case 3: Boundary match (should be False)
+    # This is where the bug is: currently it returns True because "myexample.com".endswith("example.com") is True
+    print(f"myexample.com with no_proxy=example.com: {should_bypass_proxies('http://myexample.com/', 'example.com')}")
+    assert should_bypass_proxies("http://myexample.com/", "example.com") is False
+    
+    # Case 4: Dot prefix match
+    assert should_bypass_proxies("http://sub.example.com/", ".example.com") is True
+    assert should_bypass_proxies("http://example.com/", ".example.com") is False
+    
+    # Case 5: Port match
+    assert should_bypass_proxies("http://example.com:8080/", "example.com:8080") is True
+    assert should_bypass_proxies("http://sub.example.com:8080/", "example.com:8080") is True
+    assert should_bypass_proxies("http://myexample.com:8080/", "example.com:8080") is False
+
+if __name__ == "__main__":
+    try:
+        test_no_proxy_boundary()
+        print("All tests passed!")
+    except AssertionError as e:
+        print("Test failed!")
+        raise e
