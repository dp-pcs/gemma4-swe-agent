index 00000000..a7bd1531
--- /dev/null
+++ b/repro.py
@@ -0,0 +1,29 @@
+
+from fastapi import APIRouter, FastAPI
+from fastapi.exceptions import FastAPIError
+
+def test_router_include_self():
+    router = APIRouter()
+    try:
+        router.include_router(router)
+        print("Successfully included router into itself (this should fail)")
+    except FastAPIError as e:
+        print(f"Caught expected FastAPIError: {e}")
+    except Exception as e:
+        print(f"Caught unexpected exception: {type(e).__name__}: {e}")
+
+def test_app_include_self():
+    app = FastAPI()
+    try:
+        app.include_router(app)
+        print("Successfully included app into itself (this should fail)")
+    except FastAPIError as e:
+        print(f"Caught expected FastAPIError: {e}")
+    except Exception as e:
+        print(f"Caught unexpected exception: {type(e).__name__}: {e}")
+
+if __name__ == "__main__":
+    print("Testing router include self...")
+    test_router_include_self()
+    print("\nTesting app include self...")
+    test_app_include_self()
