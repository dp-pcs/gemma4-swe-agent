new file mode 100644
index 00000000..9d81b405
--- /dev/null
+++ b/module_wrap.py
@@ -0,0 +1,7 @@
+import functools
+
+def wrapper(func):
+    @functools.wraps(func)
+    def wrapped(*args, **kwargs):
+        return func(*args, **kwargs)
+    return wrapped
