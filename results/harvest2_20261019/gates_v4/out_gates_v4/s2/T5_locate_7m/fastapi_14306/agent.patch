+def _get_endpoint_metadata(dependant: "Dependant", route: Any, request: Any) -> Dict[str, Any]:
+    if hasattr(dependant, "_endpoint_metadata"):
+        return dependant._endpoint_metadata
+
+    func = dependant.call
+    try:
+        source_file = inspect.getfile(func)
+        lines, start_line = inspect.getsourcelines(func)
+    except (TypeError, OSError):
+        source_file = "unknown"
+        start_line = 0
+
+    metadata = {
+        "file": source_file,
+        "line": start_line,
+        "name": func.__name__,
+        "method": request.method if hasattr(request, "method") else "UNKNOWN",
+        "route": route.path_format if hasattr(route, "path_format") else "UNKNOWN",
+    }
+    dependant._endpoint_metadata = metadata
+    return metadata
+
