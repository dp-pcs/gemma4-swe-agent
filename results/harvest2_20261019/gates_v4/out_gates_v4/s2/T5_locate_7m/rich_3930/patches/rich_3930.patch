+def split_graphemes(text: str) -> list[str]:
+    """Split text into graphemes."""
+    if not text:
+        return []
+
+    graphemes = []
+    current_grapheme = ""
+    prev_was_zwj = False
+
+    for char in text:
+        if prev_was_zwj or unicodedata.category(char).startswith("M") or char == "‍":
+            current_grapheme += char
+            prev_was_zwj = (char == "‍")
+        else:
+            if current_grapheme:
+                graphemes.append(current_grapheme)
+            current_grapheme = char
+            prev_was_zwj = False
+
+    if current_grapheme:
+        graphemes.append(current_grapheme)
+
+    return graphemes
