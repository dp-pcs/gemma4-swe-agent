+"""Prepare a new release by updating the version and release notes."""
+
+import re
+import sys
+from pathlib import Path
+from datetime import date
+
+VERSION_FILE = Path("fastapi/__init__.py")
+RELEASE_NOTES_FILE = Path("docs/en/docs/release-notes.md")
+
+def main():
+    if len(sys.argv) != 2:
+        print("Usage: python scripts/prepare_release.py <version>")
+        sys.exit(1)
+
+    new_version = sys.argv[1]
+    today = date.today().isoformat()
+    version_header = f"## {new_version} ({today})"
+
+    # Update version in fastapi/__init__.py
+    content = VERSION_FILE.read_text()
+    content = re.sub(r'__version__ = ".*"', f'__version__ = "{new_version}"', content)
+    VERSION_FILE.write_text(content)
+    print(f"Updated version to {new_version} in {VERSION_FILE}")
+
+    # Update release-notes.md
+    lines = RELEASE_NOTES_FILE.read_text().splitlines(keepends=True)
+    
+    latest_changes_index = -1
+    for i, line in enumerate(lines):
+        if line.strip() == "## Latest Changes":
+            latest_changes_index = i
+            break
+    
+    if latest_changes_index == -1:
+        print("Could not find '## Latest Changes' in release-notes.md")
+        sys.exit(1)
+
+    # Find the end of the Latest Changes section
+    end_index = len(lines)
+    for i in range(latest_changes_index + 1, len(lines)):
+        if lines[i].startswith("## "):
+            end_index = i
+            break
+    
+    changes_content = "".join(lines[latest_changes_index + 1 : end_index]).strip()
+    
+    # Construct new lines
+    new_lines = lines[:latest_changes_index + 1] # Up to "## Latest Changes"
+    new_lines.append("\n") # Empty line after "## Latest Changes"
+    
+    if changes_content:
+        new_lines.append(f"{version_header}\n") # New version header
+        new_lines.append("\n") # Empty line after new version header
+        new_lines.append(changes_content + "\n") # The changes
+        new_lines.append("\n") # Empty line before next section
+    else:
+        new_lines.append(f"{version_header}\n")
+        new_lines.append("\n")
+
+    new_lines.extend(lines[end_index:]) # The rest
+    
+    RELEASE_NOTES_FILE.write_text("".join(new_lines))
+    print(f"Updated {RELEASE_NOTES_FILE}")
+
+if __name__ == "__main__":
+    main()
