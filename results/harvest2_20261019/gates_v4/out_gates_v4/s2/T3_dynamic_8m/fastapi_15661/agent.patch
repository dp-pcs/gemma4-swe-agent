+"""Prepare release by updating version and adding release date."""
+
+import argparse
+import subprocess
+import sys
+from pathlib import Path
+import re
+
+VERSION_FILE = Path("fastapi/__init__.py")
+
+def main():
+    parser = argparse.ArgumentParser(description="Prepare release")
+    parser.add_argument("version", help="The new version to set")
+    args = parser.parse_args()
+
+    # Update version in fastapi/__init__.py
+    content = VERSION_FILE.read_text()
+    new_content = re.sub(r'__version__ = ".*"', f'__version__ = "{args.version}"', content)
+    VERSION_FILE.write_text(new_content)
+    print(f"Updated version to {args.version} in {VERSION_FILE}")
+
+    # Run add_latest_release_date.py
+    print("Running add_latest_release_date.py...")
+    result = subprocess.run([sys.executable, "scripts/add_latest_release_date.py"])
+    if result.returncode != 0:
+        print("Error running add_latest_release_date.py")
+        sys.exit(result.returncode)
+
+    print("Release preparation complete!")
+
+if __name__ == "__main__":
+    main()
