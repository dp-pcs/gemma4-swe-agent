--- a/fastapi/responses.py
+++ b/fastapi/responses.py
@@ -82,3 +82,34 @@ class ORJSONResponse(JSONResponse):
         return orjson.dumps(
             content, option=orjson.OPT_NON_STR_KEYS | orjson.OPT_SERIALIZE_NUMPY
         )
+
+class SSEResponse(StreamingResponse):
+    """SSE response for Server-Sent Events.
+
+    **Note**: `SSEResponse` is a convenience wrapper around `StreamingResponse`
+    that sets the `content-type` to `text/event-stream` and adds the necessary
+    headers for SSE.
+    """
+
+    def __init__(
+        self,
+        content: Any,
+        status_code: int = 200,
+        headers: dict[str, str] | None = None,
+        background: Any = None,
+        media_type: str = "text/event-stream",
+    ) -> None:
+        if headers is None:
+            headers = {}
+        else:
+            headers = headers.copy()
+        headers["Cache-Control"] = "no-cache"
+        headers["Connection"] = "keep-alive"
+        headers["Content-Type"] = media_type
+        super().__init__(
+            content=content,
+            status_code=status_code,
+            headers=headers,
+            background=background,
+            media_type=None,
+        )
