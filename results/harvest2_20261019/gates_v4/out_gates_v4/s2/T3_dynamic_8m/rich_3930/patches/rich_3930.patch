+def split_graphemes(text: str) -> list[str]:
+    """Split a string into a list of grapheme clusters."""
+    graphemes = []
+    if not text:
+        return graphemes
+
+    current_grapheme = []
+    last_char_was_zwj = False
+    for char in text:
+        if (last_char_was_zwj or
+            unicodedata.category(char).startswith('M') or
+            char == '‍' or
+            0xFE00 <= ord(char) <= 0xFE0F or
+            0x1F3FB <= ord(char) <= 0x1F3FF):
+            current_grapheme.append(char)
+            last_char_was_zwj = (char == '‍')
+        else:
+            if current_grapheme:
+                graphemes.append("".join(current_grapheme))
+            current_grapheme = [char]
+            last_char_was_zwj = False
+    if current_grapheme:
+        graphemes.append("".join(current_grapheme))
+    return graphemes
