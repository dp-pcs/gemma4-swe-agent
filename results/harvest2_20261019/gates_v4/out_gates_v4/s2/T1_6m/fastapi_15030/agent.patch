diff --git a/fastapi/responses.py b/fastapi/responses.py
index 5b1154c0..b8df44e3 100644
--- a/fastapi/responses.py
+++ b/fastapi/responses.py
@@ -82,3 +82,27 @@ class ORJSONResponse(JSONResponse):
         return orjson.dumps(
             content, option=orjson.OPT_NON_STR_KEYS | orjson.OPT_SERIALIZE_NUMPY
         )
+
+class SSEResponse(StreamingResponse):
+    """
+    SSE response for Server-Sent Events.
+    """
+    def __init__(
+        self,
+        content: Any,
+        status_code: int = 200,
+        headers: dict[str, str] | None = None,
+        background: Any = None,
+    ):
+        if headers is None:
+            headers = {}
+        headers.setdefault("Content-Type", "text/event-stream")
+        headers.setdefault("Cache-Control", "no-cache")
+        headers.setdefault("Connection", "keep-alive")
+        super().__init__(
+            content=content,
+            status_code=status_code,
+            headers=headers,
+            background=background,
+            media_type=None,
+        )
