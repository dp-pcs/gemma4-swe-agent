diff --git a/fastapi/responses.py b/fastapi/responses.py
index 5b1154c0..8168d032 100644
--- a/fastapi/responses.py
+++ b/fastapi/responses.py
@@ -82,3 +82,49 @@ class ORJSONResponse(JSONResponse):
         return orjson.dumps(
             content, option=orjson.OPT_NON_STR_KEYS | orjson.OPT_SERIALIZE_NUMPY
         )
+
+def _format_sse(item: Any) -> str:
+    if isinstance(item, dict):
+        lines = []
+        if "data" in item:
+            lines.append(f"data: {item['data']}")
+        if "event" in item:
+            lines.append(f"event: {item['event']}")
+        if "id" in item:
+            lines.append(f"id: {item['id']}")
+        if "retry" in item:
+            lines.append(f"retry: {item['retry']}")
+        return "\n".join(lines) + "\n\n"
+    return f"data: {item}\n\n"
+
+class SSEResponse(StreamingResponse):
+    """
+    Response class for Server-Sent Events (SSE).
+
+    The `content` argument should be an iterable or async iterable of strings or
+    dictionaries. If a dictionary is provided, it should contain keys like
+    `data`, `event`, `id`, and `retry`.
+    """
+
+    def __init__(
+        self,
+        content,
+        status_code: int = 200,
+        headers: dict[str, str] | None = None,
+        background: Any = None,
+    ):
+        if headers is None:
+            headers = {}
+        headers["Content-Type"] = "text/event-stream"
+        headers["Cache-Control"] = "no-cache"
+        headers["Connection"] = "keep-alive"
+
+        async def sse_generator():
+            if hasattr(content, "__aiter__"):
+                async for item in content:
+                    yield _format_sse(item)
+            else:
+                for item in content:
+                    yield _format_sse(item)
+
+        super().__init__(content=sse_generator(), status_code=status_code, headers=headers, background=background)
