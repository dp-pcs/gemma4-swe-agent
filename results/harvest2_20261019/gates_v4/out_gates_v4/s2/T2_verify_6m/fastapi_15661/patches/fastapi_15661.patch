+++ b/scripts/prepare_release.py
@@ -0,0 +1,43 @@
+import sys
+import re
+import subprocess
+from pathlib import Path
+
+def main():
+    if len(sys.argv) < 2:
+        print("Usage: python scripts/prepare_release.py <version>")
+        sys.exit(1)
+    
+    version = sys.argv[1]
+    
+    # Bump version in fastapi/__init__.py
+    init_file = Path("fastapi/__init__.py")
+    content = init_file.read_text()
+    init_file.write_text(re.sub(r'__version__ = ".*"', f'__version__ = "{version}"', content))
+    print(f"Updated version to {version} in fastapi/__init__.py")
+    
+    # Add version header to release notes
+    rn_file = Path("docs/en/docs/release-notes.md")
+    lines = rn_file.read_text().splitlines(keepends=True)
+    
+    # Find the first versioned header (## 0.x.x)
+    version_header_index = -1
+    for i, line in enumerate(lines):
+        if re.match(r'^## \d+\.\d+\.\d+', line):
+            version_header_index = i
+            break
+    
+    if version_header_index != -1:
+        lines.insert(version_header_index, f"## {version}\n\n")
+        rn_file.write_text("".join(lines))
+        print(f"Added version header {version} to release notes")
+    else:
+        print("No versioned header found in release notes")
+        sys.exit(1)
+    
+    # Run the date script
+    subprocess.run([sys.executable, "scripts/add_latest_release_date.py"], check=True)
+    print("Updated release date in release notes")
+
+if __name__ == "__main__":
+    main()
