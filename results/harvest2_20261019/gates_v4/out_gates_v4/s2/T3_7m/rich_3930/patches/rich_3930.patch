+def split_graphemes(text: str) -> list[str]:
+    """Split text into a list of graphemes."""
+    graphemes: list[str] = []
+    if not text:
+        return graphemes
+
+    current_grapheme = text[0]
+    for i in range(1, len(text)):
+        char = text[i]
+        prev_char = text[i - 1]
+        if (
+            unicodedata.category(char).startswith("M")
+            or char == "‍"
+            or prev_char == "‍"
+        ):
+            current_grapheme += char
+        else:
+            graphemes.append(current_grapheme)
+            current_grapheme = char
+
+    graphemes.append(current_grapheme)
+    return graphemes
+
