+def iter_graphemes(text: str) -> Iterator[str]:
+    """Split text into grapheme clusters."""
+    if not text:
+        return
+
+    grapheme = ""
+    for char in text:
+        if (
+            unicodedata.combining(char)
+            or ord(char) == 0x200D
+            or 0xFE00 <= ord(char) <= 0xFE0F
+            or 0x1F3FB <= ord(char) <= 0x1F3FF
+        ):
+            grapheme += char
+        else:
+            if grapheme:
+                yield grapheme
+            grapheme = char
+    if grapheme:
+        yield grapheme
+
