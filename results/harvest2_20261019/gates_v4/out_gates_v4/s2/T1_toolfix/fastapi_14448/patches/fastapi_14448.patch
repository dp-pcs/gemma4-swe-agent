+def _is_callable_type(obj: Any, check_fn: Callable[[Any], bool]) -> bool:
+    while True:
+        if check_fn(obj):
+            return True
+        if isinstance(obj, partial):
+            obj = obj.func
+        elif hasattr(obj, "__wrapped__"):
+            obj = obj.__wrapped__
+        elif hasattr(obj, "__call__") and not inspect.isroutine(obj):
+            obj = getattr(obj, "__call__")
+        else:
+            break
+    return False
