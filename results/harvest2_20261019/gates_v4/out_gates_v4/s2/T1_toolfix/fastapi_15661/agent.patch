+"""Prepare a new release by updating the version and release notes."""
+
+import argparse
+import re
+import sys
+import subprocess
+from pathlib import Path
+
+VERSION_FILE = Path("fastapi/__init__.py")
+RELEASE_NOTES_FILE = Path("docs/en/docs/release-notes.md")
+
+def update_version(new_version: str):
+    content = VERSION_FILE.read_text()
+    new_content = re.sub(r'__version__ = ".*"', f'__version__ = "{new_version}"', content)
+    VERSION_FILE.write_text(new_content)
+    print(f"Updated version to {new_version} in {VERSION_FILE}")
+
+def update_release_notes(new_version: str):
+    lines = RELEASE_NOTES_FILE.read_text().splitlines(keepends=True)
+    
+    latest_changes_index = -1
+    for i, line in enumerate(lines):
+        if line.strip() == "## Latest Changes":
+            latest_changes_index = i
+            break
+    
+    if latest_changes_index == -1:
+        print("Could not find '## Latest Changes' header in release notes")
+        sys.exit(1)
+    
+    first_version_index = -1
+    for i in range(latest_changes_index + 1, len(lines)):
+        if re.match(r"^## \d", lines[i]):
+            first_version_index = i
+            break
+    
+    if first_version_index == -1:
+        # No previous version headers found, take everything after Latest Changes
+        changes = lines[latest_changes_index + 1:]
+        new_lines = lines[:latest_changes_index + 1]
+        new_lines.append("\n")
+        new_lines.append(f"## {new_version}\n\n")
+        new_lines.extend(changes)
+    else:
+        # Extract changes between Latest Changes and the first version header
+        changes = lines[latest_changes_index + 1 : first_version_index]
+        
+        # Remove empty lines at the beginning and end of changes
+        while changes and not changes[0].strip():
+            changes.pop(0)
+        while changes and not changes[-1].strip():
+            changes.pop()
+            
+        new_lines = lines[:latest_changes_index + 1]
+        new_lines.append("\n")
+        new_lines.append(f"## {new_version}\n\n")
+        new_lines.extend(changes)
+        new_lines.append("\n")
+        new_lines.extend(lines[first_version_index:])
+        
+    RELEASE_NOTES_FILE.write_text("".join(new_lines))
+    print(f"Updated release notes for version {new_version}")
+
+def main():
+    parser = argparse.ArgumentParser(description="Prepare a new release")
+    parser.add_argument("version", help="The new version number")
+    args = parser.parse_args()
+    
+    update_version(args.version)
+    update_release_notes(args.version)
+    
+    # Call add_latest_release_date.py
+    subprocess.run([sys.executable, "scripts/add_latest_release_date.py"], check=True)
+
+if __name__ == "__main__":
+    main()
