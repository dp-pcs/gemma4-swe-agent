+"""Prepare the release by adding the latest release date."""
+
+import subprocess
+import sys
+
+def main() -> None:
+    print("Preparing release...")
+    result = subprocess.run([sys.executable, "scripts/add_latest_release_date.py"])
+    if result.returncode != 0:
+        print("Error adding latest release date")
+        sys.exit(result.returncode)
+    print("Release preparation complete.")
+
+if __name__ == "__main__":
+    main()
