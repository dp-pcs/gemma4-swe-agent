+
+class SSEResponse(StreamingResponse):
+    """SSE response for Server-Sent Events.
+
+    This response class wraps the content in the SSE format: `data: <message>\n\n`.
+    If the content is not a string, it is serialized to JSON.
+    """
+
+    def __init__(
+        self,
+        content: Any,
+        status_code: int = 200,
+        headers: dict[str, str] | None = None,
+        background: Any = None,
+        media_type: str = "text/event-stream",
+    ) -> None:
+        super().__init__(
+            content=self._wrap_content(content),
+            status_code=status_code,
+            headers=headers,
+            background=background,
+            media_type=media_type,
+        )
+
+    def _wrap_content(self, content: Any) -> AsyncIterator[str]:
+        async def wrap() -> AsyncIterator[str]:
+            if isinstance(content, str):
+                yield f"data: {content}\n\n"
+            elif hasattr(content, "__aiter__"):
+                async for item in content:
+                    yield f"data: {self._serialize_item(item)}\n\n"
+            elif hasattr(content, "__iter__"):
+                for item in content:
+                    yield f"data: {self._serialize_item(item)}\n\n"
+            else:
+                yield f"data: {self._serialize_item(content)}\n\n"
+        return wrap()
+
+    def _serialize_item(self, item: Any) -> str:
+        if isinstance(item, str):
+            return item
+        return json.dumps(jsonable_encoder(item))
