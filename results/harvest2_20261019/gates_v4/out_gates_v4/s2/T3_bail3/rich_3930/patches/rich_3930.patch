+def split_graphemes(text: str) -> list[str]:
+    """Split a string into a list of graphemes."""
+    if not text:
+        return []
+
+    graphemes = []
+    current_grapheme = ""
+
+    for char in text:
+        if not current_grapheme:
+            current_grapheme += char
+        else:
+            if unicodedata.combining(char) or char == "‍" or current_grapheme[-1] == "‍":
+                current_grapheme += char
+            else:
+                graphemes.append(current_grapheme)
+                current_grapheme = char
+
+    if current_grapheme:
+        graphemes.append(current_grapheme)
+
+    return graphemes
+
+
+def get_grapheme_cell_size(grapheme: str) -> int:
+    """Get the cell size of a grapheme."""
+    for char in grapheme:
+        width = get_character_cell_size(char)
+        if width > 0:
+            return width
+    return 0
+
