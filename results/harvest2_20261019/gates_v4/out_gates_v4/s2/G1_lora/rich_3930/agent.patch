+def split_graphemes(text: str) -> list[str]:
+    """Split a string into graphemes.
+
+    A grapheme is a sequence of characters that produce a single glyph.
+    This implementation groups characters with a width of 0 with the
+    preceding character.
+    """
+    graphemes = []
+    if not text:
+        return graphemes
+
+    current_grapheme = text[0]
+    for char in text[1:]:
+        if get_character_cell_size(char) == 0:
+            current_grapheme += char
+        else:
+            graphemes.append(current_grapheme)
+            current_grapheme = char
+    graphemes.append(current_grapheme)
+    return graphemes
