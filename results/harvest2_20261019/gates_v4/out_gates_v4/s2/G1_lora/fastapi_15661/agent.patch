+import re
+import subprocess
+import sys
+import typer
+from pathlib import Path
+
+VERSION_FILE = Path("fastapi/__init__.py")
+RELEASE_NOTES_FILE = Path("docs/en/docs/release-notes.md")
+VERSION_HEADER_PATTERN = re.compile(r"^## \d+\.\d+\.\d+")
+
+def update_version(version: str) -> None:
+    content = VERSION_FILE.read_text()
+    new_content = re.sub(r'__version__ = ".*"', f'__version__ = "{version}"', content)
+    VERSION_FILE.write_text(new_content)
+    print(f"Updated version to {version} in {VERSION_FILE}")
+
+def add_version_header(version: str) -> None:
+    lines = RELEASE_NOTES_FILE.read_text().splitlines(keepends=True)
+    for i, line in enumerate(lines):
+        if VERSION_HEADER_PATTERN.match(line):
+            # Check if the version already exists
+            if line.startswith(f"## {version}"):
+                print(f"Version header ## {version} already exists in {RELEASE_NOTES_FILE}")
+                return
+            
+            # Insert the new version header
+            lines.insert(i, f"## {version}\n")
+            RELEASE_NOTES_FILE.write_text("".join(lines))
+            print(f"Added version header ## {version} to {RELEASE_NOTES_FILE}")
+            return
+    
+    # If no version header found, append to the end
+    lines.append(f"\n## {version}\n")
+    RELEASE_NOTES_FILE.write_text("".join(lines))
+    print(f"Added version header ## {version} to the end of {RELEASE_NOTES_FILE}")
+
+def main(version: str):
+    update_version(version)
+    add_version_header(version)
+    subprocess.run([sys.executable, "scripts/add_latest_release_date.py"], check=True)
+
+if __name__ == "__main__":
+    typer.run(main)
