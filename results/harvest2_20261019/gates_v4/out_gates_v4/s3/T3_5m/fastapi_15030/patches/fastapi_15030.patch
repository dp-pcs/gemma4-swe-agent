diff --git a/fastapi/responses.py b/fastapi/responses.py
index 5b1154c0..cfbeca97 100644
--- a/fastapi/responses.py
+++ b/fastapi/responses.py
@@ -82,3 +82,27 @@ class ORJSONResponse(JSONResponse):
         return orjson.dumps(
             content, option=orjson.OPT_NON_STR_KEYS | orjson.OPT_SERIALIZE_NUMPY
         )
+
+class SSEResponse(StreamingResponse):
+    """SSE response for Server-Sent Events.
+
+    This response type sets the `Content-Type` to `text/event-stream` and
+    the `Cache-Control` to `no-cache` and `Connection` to `keep-alive`.
+    """
+
+    def __init__(
+        self,
+        content,
+        status_code: int = 200,
+        headers: dict[str, str] | None = None,
+        background: Any = None,
+        media_type: str = "text/event-stream",
+    ):
+        if headers is None:
+            headers = {}
+        headers["Cache-Control"] = "no-cache"
+        headers["Connection"] = "keep-alive"
+        headers["Content-Type"] = media_type
+        super().__init__(
+            content, status_code=status_code, headers=headers, background=background, media_type=None
+        )
