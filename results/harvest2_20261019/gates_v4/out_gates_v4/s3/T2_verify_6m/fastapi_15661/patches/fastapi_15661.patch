+"""Automate release preparation process."""
+
+import sys
+import re
+from pathlib import Path
+import subprocess
+
+def main():
+    if len(sys.argv) != 2:
+        print("Usage: python scripts/release.py <version>")
+        sys.exit(1)
+
+    version = sys.argv[1]
+    
+    # 1. Update fastapi/__init__.py
+    init_file = Path("fastapi/__init__.py")
+    content = init_file.read_text()
+    new_content = re.sub(r'^__version__ = ".*"$', f'__version__ = "{version}"', content, flags=re.MULTILINE)
+    if content == new_content:
+        print(f"Version in fastapi/__init__.py is already {version}")
+    else:
+        init_file.write_text(new_content)
+        print(f"Updated fastapi/__init__.py to version {version}")
+
+    # 2. Update docs/en/docs/release-notes.md
+    release_notes_file = Path("docs/en/docs/release-notes.md")
+    content = release_notes_file.read_text()
+    if f"## {version}" in content:
+        print(f"Version {version} already exists in release-notes.md")
+    else:
+        lines = content.splitlines(keepends=True)
+        inserted = False
+        for i, line in enumerate(lines):
+            if line.strip() == "# Release Notes":
+                lines.insert(i + 1, f"## {version}\n")
+                inserted = True
+                break
+        if not inserted:
+            print("Could not find '# Release Notes' header in release-notes.md")
+            sys.exit(1)
+        release_notes_file.write_text("".join(lines))
+        print(f"Added version header {version} to release-notes.md")
+
+    # 3. Run scripts/add_latest_release_date.py
+    subprocess.run([sys.executable, "scripts/add_latest_release_date.py"], check=True)
+    print("Updated release date in release-notes.md")
+
+if __name__ == "__main__":
+    main()
