@@ -0,0 +1,60 @@
+import re
+import sys
+import subprocess
+from pathlib import Path
+
+VERSION_FILE = Path("fastapi/__init__.py")
+RELEASE_NOTES_FILE = Path("docs/en/docs/release-notes.md")
+
+def main():
+    if len(sys.argv) != 2:
+        print("Usage: python scripts/prepare_release.py <version>")
+        sys.exit(1)
+
+    new_version = sys.argv[1]
+
+    # 1. Update version in fastapi/__init__.py
+    content = VERSION_FILE.read_text()
+    new_content = re.sub(r'__version__ = ".*"', f'__version__ = "{new_version}"', content)
+    VERSION_FILE.write_text(new_content)
+    print(f"Updated version to {new_version} in {VERSION_FILE}")
+
+    # 2. Update release-notes.md
+    lines = RELEASE_NOTES_FILE.read_text().splitlines(keepends=True)
+    
+    latest_changes_index = -1
+    first_version_index = -1
+    
+    for i, line in enumerate(lines):
+        if line.strip() == "## Latest Changes":
+            latest_changes_index = i
+        elif re.match(r"^## \d+\.\d+\.\d+", line.strip()):
+            first_version_index = i
+            break
+            
+    if latest_changes_index == -1:
+        print("Could not find '## Latest Changes' in release-notes.md")
+        sys.exit(1)
+        
+    if first_version_index == -1:
+        print("Could not find any version header in release-notes.md")
+        sys.exit(1)
+        
+    # Extract content between '## Latest Changes' and the first version header
+    changes_content = "".join(lines[latest_changes_index + 1 : first_version_index]).strip()
+    
+    # Rebuild the file content
+    prefix = "".join(lines[:latest_changes_index + 1]).rstrip()
+    suffix = "".join(lines[first_version_index:]).lstrip()
+    
+    new_text = f"{prefix}\n\n## {new_version}\n\n{changes_content}\n\n{suffix}"
+    
+    RELEASE_NOTES_FILE.write_text(new_text)
+    print(f"Updated {RELEASE_NOTES_FILE}")
+
+    # 3. Execute add_latest_release_date.py
+    subprocess.run([sys.executable, "scripts/add_latest_release_date.py"], check=True)
+    print("Updated release date in release-notes.md")
+
+if __name__ == "__main__":
+    main()
