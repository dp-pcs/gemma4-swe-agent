@@ -0,0 +1,59 @@
+import re
+import subprocess
+import sys
+from pathlib import Path
+from typing import Annotated
+
+import typer
+
+VERSION_FILE = Path("fastapi/__init__.py")
+RELEASE_NOTES_FILE = Path("docs/en/docs/release-notes.md")
+VERSION_PATTERN = re.compile(r"^(\d+\.\d+\.\d+)$")
+RELEASE_HEADER_PATTERN = re.compile(r"^## (\d+\.\d+\.\d+)")
+
+app = typer.Typer()
+
+@app.command()
+def main(
+    version: Annotated[str, typer.Argument(help="The new version to set (e.g. 0.136.4)")]
+) -> None:
+    """
+    Prepare the release by updating the version in fastapi/__init__.py 
+    and adding a new version header to docs/en/docs/release-notes.md.
+    """
+    if not VERSION_PATTERN.match(version):
+        typer.echo(f"Invalid version format: {version}. Expected X.Y.Z")
+        raise typer.Exit(code=1)
+
+    # Update fastapi/__init__.py
+    content = VERSION_FILE.read_text()
+    new_content = re.sub(r'__version__ = ".*"', f'__version__ = "{version}"', content)
+    VERSION_FILE.write_text(new_content)
+    typer.echo(f"Updated {VERSION_FILE} to version {version}")
+
+    # Update docs/en/docs/release-notes.md
+    lines = RELEASE_NOTES_FILE.read_text().splitlines(keepends=True)
+    
+    insert_index = -1
+    for i, line in enumerate(lines):
+        if RELEASE_HEADER_PATTERN.match(line):
+            # Check if this version already exists
+            if line.strip().startswith(f"## {version}"):
+                typer.echo(f"Version {version} already exists in {RELEASE_NOTES_FILE}")
+                raise typer.Exit(code=1)
+            insert_index = i
+            break
+    
+    if insert_index != -1:
+        lines.insert(insert_index, f"## {version}\n")
+        RELEASE_NOTES_FILE.write_text("".join(lines))
+        typer.echo(f"Added {version} to {RELEASE_NOTES_FILE}")
+    else:
+        typer.echo(f"Could not find a version header in {RELEASE_NOTES_FILE} to insert before.")
+        raise typer.Exit(code=1)
+
+    # Add the date to the new version header
+    subprocess.run([sys.executable, "scripts/add_latest_release_date.py"], check=True)
+
+if __name__ == "__main__":
+    app()
