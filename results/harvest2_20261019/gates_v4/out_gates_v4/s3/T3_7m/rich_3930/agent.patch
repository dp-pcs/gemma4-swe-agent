+def split_graphemes(text: str) -> list[str]:
+    """Split a string into a list of grapheme clusters."""
+    if not text:
+        return []
+    graphemes = []
+    current_grapheme = ""
+    for char in text:
+        if not current_grapheme:
+            current_grapheme = char
+        elif unicodedata.combining(char) or char == "\u200d" or (current_grapheme and current_grapheme[-1] == "\u200d"):
+            current_grapheme += char
+        else:
+            graphemes.append(current_grapheme)
+            current_grapheme = char
+    if current_grapheme:
+        graphemes.append(current_grapheme)
+    return graphemes
+
