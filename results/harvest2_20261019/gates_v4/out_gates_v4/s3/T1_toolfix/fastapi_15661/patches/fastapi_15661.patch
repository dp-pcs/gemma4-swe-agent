+"""Automate release preparation."""
+
+import re
+import sys
+import subprocess
+from pathlib import Path
+
+VERSION_FILE = Path("fastapi/__init__.py")
+RELEASE_NOTES_FILE = Path("docs/en/docs/release-notes.md")
+RELEASE_HEADER_PATTERN = re.compile(r"^## (\d+\.\d+\.\d+)")
+
+def update_version(version: str) -> None:
+    content = VERSION_FILE.read_text()
+    new_content = re.sub(r'^__version__ = ".*"$', f'__version__ = "{version}"', content, flags=re.MULTILINE)
+    VERSION_FILE.write_text(new_content)
+    print(f"Updated version to {version} in {VERSION_FILE}")
+
+def update_release_notes(version: str) -> None:
+    lines = RELEASE_NOTES_FILE.read_text().splitlines(keepends=True)
+    
+    insert_index = -1
+    for i, line in enumerate(lines):
+        if RELEASE_HEADER_PATTERN.match(line):
+            insert_index = i
+            break
+    
+    if insert_index == -1:
+        print("No versioned header found in release notes. Appending to end.")
+        lines.append(f"\n## {version}\n")
+    else:
+        lines.insert(insert_index, f"## {version}\n")
+        print(f"Inserted {version} header at line {insert_index + 1}")
+    
+    RELEASE_NOTES_FILE.write_text("".join(lines))
+
+def main() -> None:
+    if len(sys.argv) != 2:
+        print("Usage: python scripts/release.py <version>")
+        sys.exit(1)
+    
+    version = sys.argv[1]
+    
+    update_version(version)
+    update_release_notes(version)
+    
+    # Run scripts/add_latest_release_date.py
+    result = subprocess.run([sys.executable, "scripts/add_latest_release_date.py"])
+    if result.returncode != 0:
+        print("Error running scripts/add_latest_release_date.py")
+        sys.exit(result.returncode)
+
+if __name__ == "__main__":
+    main()
