+def graphemes(text: str) -> list[str]:
+    """Split text into graphemes."""
+    graphemes = []
+    if not text:
+        return graphemes
+
+    current_grapheme = text[0]
+    for char in text[1:]:
+        if (
+            unicodedata.category(char).startswith("M")
+            or char == "‍"
+            or 0x1F3FB <= ord(char) <= 0x1F3FF
+        ):
+            current_grapheme += char
+        else:
+            graphemes.append(current_grapheme)
+            current_grapheme = char
+    graphemes.append(current_grapheme)
+    return graphemes
+
 
 
