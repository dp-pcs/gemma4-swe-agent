+"""Automate release preparation: update version and release notes."""
+
+import re
+import subprocess
+import sys
+from pathlib import Path
+
+VERSION_FILE = Path("fastapi/__init__.py")
+RELEASE_NOTES_FILE = Path("docs/en/docs/release-notes.md")
+
+def update_version(version: str) -> None:
+    content = VERSION_FILE.read_text()
+    new_content = re.sub(r'__version__ = ".*"', f'__version__ = "{version}"', content)
+    VERSION_FILE.write_text(new_content)
+
+def update_release_notes(version: str) -> None:
+    content = RELEASE_NOTES_FILE.read_text()
+
+    # Find the content under ## Latest Changes
+    # It starts from ## Latest Changes and goes until the next ## header
+    match = re.search(r'(## Latest Changes\s*\n\s*\n)(.*?)(?=\n\n## |\Z)', content, re.DOTALL)
+    if not match:
+        print("Could not find ## Latest Changes section")
+        sys.exit(1)
+
+    header = match.group(1)
+    changes = match.group(2).strip()
+
+    # Create the new version section
+    if changes:
+        new_section = f"## {version}\n\n{changes}\n\n"
+    else:
+        new_section = f"## {version}\n\n"
+
+    # Replace the match with the header and the new section
+    new_content = content[:match.start()] + header + new_section + content[match.end():]
+
+    RELEASE_NOTES_FILE.write_text(new_content)
+
+def main() -> None:
+    if len(sys.argv) != 2:
+        print("Usage: python scripts/release.py <version>")
+        sys.exit(1)
+
+    version = sys.argv[1]
+    update_version(version)
+    update_release_notes(version)
+
+    # Add date to the latest release header
+    try:
+        subprocess.run(["uv", "run", "python", "scripts/add_latest_release_date.py"], check=True)
+    except subprocess.CalledProcessError as e:
+        print(f"Error adding release date: {e}")
+        sys.exit(1)
+
+if __name__ == "__main__":
+    main()
