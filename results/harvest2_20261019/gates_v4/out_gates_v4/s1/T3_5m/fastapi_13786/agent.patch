index 496c815a..7fcd9899 100644
--- a/fastapi/security/api_key.py
+++ b/fastapi/security/api_key.py
@@ -108,6 +108,9 @@ class APIKeyQuery(APIKeyBase):
         self.scheme_name = scheme_name or self.__class__.__name__
         self.auto_error = auto_error
 
+    def format_www_authenticate_header_value(self) -> str:
+        return f'ApiKey in="{self.location}", name="{self.name}"'
+
     async def __call__(self, request: Request) -> Optional[str]:
         api_key = request.query_params.get(self.model.name)
         return self.check_api_key(api_key, self.auto_error)
