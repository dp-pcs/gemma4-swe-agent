+def split_graphemes(text: str) -> list[str]:
+    """Split a string into a list of graphemes."""
+    if not text:
+        return []
+
+    graphemes: list[str] = []
+    current_grapheme = ""
+
+    for char in text:
+        if current_grapheme and _get_character_cell_size(char) == 0:
+            current_grapheme += char
+        else:
+            if current_grapheme:
+                graphemes.append(current_grapheme)
+            current_grapheme = char
+
+    if current_grapheme:
+        graphemes.append(current_grapheme)
+
+    return graphemes
+
