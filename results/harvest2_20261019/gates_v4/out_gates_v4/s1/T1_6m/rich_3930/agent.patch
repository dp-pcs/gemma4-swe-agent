+def split_graphemes(text: str) -> list[str]:
+    """Split a string into a list of graphemes."""
+    graphemes = []
+    for char in text:
+        if not graphemes:
+            graphemes.append(char)
+            continue
+
+        prev = graphemes[-1]
+        prev_char = prev[-1]
+
+        if unicodedata.combining(char):
+            graphemes[-1] += char
+        elif char == "\u200d":
+            graphemes[-1] += char
+        elif 0x1F3FB <= ord(char) <= 0x1F3FF:
+            graphemes[-1] += char
+        elif 0x1F1E6 <= ord(char) <= 0x1F1FF and 0x1F1E6 <= ord(prev_char) <= 0x1F1FF:
+            graphemes[-1] += char
+        elif prev_char == "\u200d":
+            graphemes[-1] += char
+        else:
+            graphemes.append(char)
+    return graphemes
+
