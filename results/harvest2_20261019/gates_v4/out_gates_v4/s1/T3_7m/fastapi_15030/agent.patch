diff --git a/fastapi/responses.py b/fastapi/responses.py
index 5b1154c0..692846e5 100644
--- a/fastapi/responses.py
+++ b/fastapi/responses.py
@@ -82,3 +82,24 @@ class ORJSONResponse(JSONResponse):
         return orjson.dumps(
             content, option=orjson.OPT_NON_STR_KEYS | orjson.OPT_SERIALIZE_NUMPY
         )
+
+class SSEResponse(StreamingResponse):
+    """SSE response for Server-Sent Events."""
+
+    def __init__(
+        self,
+        content,
+        status_code: int = 200,
+        headers: Any = None,
+        background: Any = None,
+    ):
+        default_headers = {"Cache-Control": "no-cache", "Connection": "keep-alive"}
+        if headers:
+            default_headers.update(headers)
+        super().__init__(
+            content,
+            status_code=status_code,
+            headers=default_headers,
+            background=background,
+            media_type="text/event-stream",
+        )
