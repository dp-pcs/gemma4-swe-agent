diff --git a/scripts/prepare_release.py b/scripts/prepare_release.py
new file mode 100644
index 000000000..d68c16904
--- /dev/null
+++ b/scripts/prepare_release.py
@@ -0,0 +1,47 @@
+"""Script to prepare a new release by updating the version in fastapi/__init__.py and adding a version header to release-notes.md."""
+
+import sys
+import re
+from pathlib import Path
+
+def main() -> None:
+    if len(sys.argv) != 2:
+        print("Usage: python scripts/prepare_release.py <version>")
+        sys.exit(1)
+
+    version = sys.argv[1]
+    
+    # Update fastapi/__init__.py
+    init_file = Path("fastapi/__init__.py")
+    content = init_file.read_text()
+    new_content = re.sub(r'__version__ = ".*"', f'__version__ = "{version}"', content)
+    init_file.write_text(new_content)
+    print(f"Updated fastapi/__init__.py to version {version}")
+
+    # Update docs/en/docs/release-notes.md
+    release_notes_file = Path("docs/en/docs/release-notes.md")
+    content = release_notes_file.read_text()
+    
+    # Check if version header already exists
+    if f"## {version}" in content:
+        print(f"Version {version} already exists in release-notes.md")
+    else:
+        # Insert before the first version header (## \d.\d.\d)
+        match = re.search(r'^## \d+\.\d+\.\d+', content, re.MULTILINE)
+        if match:
+            start = match.start()
+            new_content = content[:start] + f"## {version}\n\n" + content[start:]
+        else:
+            # If no version header exists, insert before ## Latest Changes
+            match_latest = re.search(r'^## Latest Changes', content, re.MULTILINE)
+            if match_latest:
+                start = match_latest.start()
+                new_content = content[:start] + f"## {version}\n\n" + content[start:]
+            else:
+                new_content = f"## {version}\n\n" + content
+        
+        release_notes_file.write_text(new_content)
+        print(f"Added version {version} to release-notes.md")
+
+if __name__ == "__main__":
+    main()
