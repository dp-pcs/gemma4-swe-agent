+"""Automate release preparation."""
+
+import re
+import sys
+from pathlib import Path
+
+VERSION_FILE = "fastapi/__init__.py"
+RELEASE_NOTES_FILE = "docs/en/docs/release-notes.md"
+
+def main() -> None:
+    if len(sys.argv) != 2:
+        print("Usage: python scripts/release.py <version>")
+        sys.exit(1)
+
+    version = sys.argv[1]
+
+    # Update version in fastapi/__init__.py
+    with open(VERSION_FILE, "r") as f:
+        content = f.read()
+    
+    new_content = re.sub(r'__version__ = ".*"', f'__version__ = "{version}"', content)
+    with open(VERSION_FILE, "w") as f:
+        f.write(new_content)
+    print(f"Updated {VERSION_FILE} to version {version}")
+
+    # Update release notes
+    with open(RELEASE_NOTES_FILE, "r") as f:
+        content = f.read()
+    
+    # Insert the new version header after "## Latest Changes\n\n"
+    # We use a regex to be more flexible with whitespace
+    pattern = r"(## Latest Changes\n\n)"
+    replacement = rf"\1## {version}\n\n"
+    
+    if re.search(pattern, content):
+        new_content = re.sub(pattern, replacement, content, count=1)
+        with open(RELEASE_NOTES_FILE, "w") as f:
+            f.write(new_content)
+        print(f"Added version {version} header to {RELEASE_NOTES_FILE}")
+    else:
+        print(f"Could not find '## Latest Changes' header in {RELEASE_NOTES_FILE}")
+        sys.exit(1)
+
+if __name__ == "__main__":
+    main()
