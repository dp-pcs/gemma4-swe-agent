+def split_graphemes(text: str) -> list[str]:
+    """Split a string into a list of graphemes."""
+    if not text:
+        return []
+    graphemes = []
+    current_grapheme = text[0]
+    i = 1
+    while i < len(text):
+        char = text[i]
+        if unicodedata.combining(char) or char in "\ufe0e\ufe0f":
+            current_grapheme += char
+        elif char == "\u200d":
+            current_grapheme += char
+            if i + 1 < len(text):
+                current_grapheme += text[i+1]
+                i += 1
+        else:
+            graphemes.append(current_grapheme)
+            current_grapheme = char
+        i += 1
+    graphemes.append(current_grapheme)
+    return graphemes
+
