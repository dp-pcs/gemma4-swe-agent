+import sys
+import subprocess
+from pathlib import Path
+import typer
+import re
+
+app = typer.Typer()
+
+@app.command()
+def main(version: str = typer.Argument(..., help="The new version to set (e.g., 0.136.4)")):
+    """
+    Prepare for a new release by updating the version and the release notes date.
+    """
+    # Update version in fastapi/__init__.py
+    init_file = Path("fastapi/__init__.py")
+    if not init_file.exists():
+        typer.echo(f"Error: {init_file} not found.")
+        raise typer.Exit(code=1)
+
+    content = init_file.read_text()
+    # This regex matches __version__ = "0.136.3" and replaces it with the new version
+    new_content = re.sub(r'__version__ = ".*"', f'__version__ = "{version}"', content)
+    
+    if content == new_content:
+        typer.echo(f"Version {version} is already set in {init_file}.")
+    else:
+        init_file.write_text(new_content)
+        typer.echo(f"Updated version to {version} in {init_file}.")
+
+    # Run scripts/add_latest_release_date.py
+    typer.echo("Updating release notes date...")
+    try:
+        subprocess.run([sys.executable, "scripts/add_latest_release_date.py"], check=True)
+        typer.echo("Successfully updated release notes date.")
+    except subprocess.CalledProcessError as e:
+        typer.echo(f"Error updating release notes date: {e}")
+        raise typer.Exit(code=1)
+
+    typer.echo(f"Release preparation for version {version} completed successfully.")
+
+if __name__ == "__main__":
+    app()
