+++ b/scripts/release.py
@@ -0,0 +1,35 @@
+import subprocess
+import sys
+from pathlib import Path
+import re
+
+def main():
+    if len(sys.argv) < 2:
+        print("Usage: python scripts/release.py <version>")
+        sys.exit(1)
+
+    version = sys.argv[1]
+    
+    # 1. Update version in fastapi/__init__.py
+    init_file = Path("fastapi/__init__.py")
+    content = init_file.read_text()
+    new_content = re.sub(r'__version__ = ".*"', f'__version__ = "{version}"', content)
+    init_file.write_text(new_content)
+    print(f"Updated version to {version} in {init_file}")
+
+    # 2. Update release notes date
+    subprocess.run([sys.executable, "scripts/add_latest_release_date.py"], check=True)
+
+    # 3. Run format
+    subprocess.run(["./scripts/format.sh"], check=True)
+
+    # 4. Run lint
+    subprocess.run(["./scripts/lint.sh"], check=True)
+
+    # 5. Run tests
+    subprocess.run(["./scripts/test.sh"], check=True)
+
+    print("Release preparation complete!")
+
+if __name__ == "__main__":
+    main()
