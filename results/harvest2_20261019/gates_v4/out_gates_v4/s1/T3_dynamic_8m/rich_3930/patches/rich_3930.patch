+def is_extending(char: str) -> bool:
+    if char == "‍":  # ZWJ
+        return True
+    if "🏻" <= char <= "🏿":  # Emoji modifiers
+        return True
+    if "︀" <= char <= "️":  # Variation selectors
+        return True
+    if unicodedata.category(char).startswith("M"):  # Combining marks
+        return True
+    return False
+
+
+def graphemes(text: str) -> Iterable[str]:
+    if not text:
+        return
+    
+    grapheme = ""
+    for char in text:
+        if grapheme and is_extending(char):
+            grapheme += char
+        else:
+            if grapheme:
+                yield grapheme
+            grapheme = char
+    if grapheme:
+        yield grapheme
+
