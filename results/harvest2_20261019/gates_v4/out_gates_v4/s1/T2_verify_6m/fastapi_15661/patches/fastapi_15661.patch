@@ -0,0 +1,32 @@
+import subprocess
+import sys
+from pathlib import Path
+
+import typer
+
+app = typer.Typer()
+
+@app.command()
+def main(version: str):
+    """
+    Prepare a new release.
+    """
+    # 1. Update version in fastapi/__init__.py
+    init_file = Path("fastapi/__init__.py")
+    content = init_file.read_text()
+    import re
+    new_content = re.sub(r'__version__ = ".*"', f'__version__ = "{version}"', content)
+    init_file.write_text(new_content)
+    typer.echo(f"Updated version to {version} in {init_file}")
+
+    # 2. Run add_latest_release_date.py
+    typer.echo("Adding latest release date...")
+    result = subprocess.run([sys.executable, "scripts/add_latest_release_date.py"])
+    if result.returncode != 0:
+        typer.echo("Error adding release date")
+        raise typer.Exit(code=1)
+
+    typer.echo("Release preparation complete!")
+
+if __name__ == "__main__":
+    app()
