+"""Prepare a new release by updating the version and release notes."""
+
+import argparse
+import re
+import subprocess
+import sys
+from pathlib import Path
+
+def update_version(version: str):
+    p = Path("fastapi/__init__.py")
+    s = p.read_text()
+    # Use regex to replace __version__ = "..."
+    new_s = re.sub(r'__version__ = ".*"', f'__version__ = "{version}"', s)
+    p.write_text(new_s)
+    print(f"Updated fastapi/__init__.py version to {version}")
+
+def update_release_notes(version: str):
+    p = Path("docs/en/docs/release-notes.md")
+    lines = p.read_text().splitlines(keepends=True)
+    
+    # Find the first line that matches ## \d+.\d+.\d+
+    first_release_index = -1
+    for i, line in enumerate(lines):
+        if re.match(r'^## \d+\.\d+\.\d+', line):
+            first_release_index = i
+            break
+    
+    if first_release_index == -1:
+        print("Could not find any release headers in release-notes.md")
+        sys.exit(1)
+    
+    # Insert the new version header before the first release header
+    # We add a newline before it to separate it from the "Latest Changes" section
+    lines.insert(first_release_index, f"## {version}\n\n")
+    p.write_text("".join(lines))
+    print(f"Added {version} header to docs/en/docs/release-notes.md")
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("version", help="The new version to release")
+    args = parser.parse_args()
+    
+    update_version(args.version)
+    update_release_notes(args.version)
+    
+    # Run scripts/add_latest_release_date.py
+    print("Running scripts/add_latest_release_date.py...")
+    subprocess.run([sys.executable, "scripts/add_latest_release_date.py"], check=True)
+    print("Done!")
+
+if __name__ == "__main__":
+    main()
