+import argparse
+import re
+import subprocess
+import sys
+from pathlib import Path
+
+def main():
+    parser = argparse.ArgumentParser(description="Prepare release")
+    parser.add_argument("version", help="The version to release (e.g. 0.136.4)")
+    args = parser.parse_args()
+    version = args.version
+
+    # 1. Update fastapi/__init__.py
+    init_file = Path("fastapi/__init__.py")
+    content = init_file.read_text()
+    new_content = re.sub(r'__version__ = "[^"]+"', f'__version__ = "{version}"', content)
+    if content == new_content:
+        print("Version already updated in fastapi/__init__.py or not found")
+    else:
+        init_file.write_text(new_content)
+        print(f"Updated fastapi/__init__.py to version {version}")
+
+    # 2. Update docs/en/docs/release-notes.md
+    notes_file = Path("docs/en/docs/release-notes.md")
+    content = notes_file.read_text()
+    
+    if f"## {version}" in content:
+        print(f"Version {version} already exists in release-notes.md")
+    else:
+        lines = content.splitlines(keepends=True)
+        
+        try:
+            latest_changes_index = -1
+            for i, line in enumerate(lines):
+                if line.strip() == "## Latest Changes":
+                    latest_changes_index = i
+                    break
+            
+            if latest_changes_index == -1:
+                print("Could not find '## Latest Changes' in release-notes.md")
+                sys.exit(1)
+            
+            # Replace '## Latest Changes' with '## <version>'
+            lines[latest_changes_index] = f"## {version}\n"
+            # Insert '## Latest Changes' before it
+            lines.insert(latest_changes_index, "## Latest Changes\n")
+            
+            notes_file.write_text("".join(lines))
+            print(f"Updated release-notes.md for version {version}")
+            
+        except Exception as e:
+            print(f"Error updating release-notes.md: {e}")
+            sys.exit(1)
+
+    # 3. Run scripts/add_latest_release_date.py
+    print("Adding release date...")
+    result = subprocess.run([sys.executable, "scripts/add_latest_release_date.py"])
+    if result.returncode != 0:
+        print("Error adding release date")
+        sys.exit(1)
+    
+    print("Release preparation complete!")
+
+if __name__ == "__main__":
+    main()
