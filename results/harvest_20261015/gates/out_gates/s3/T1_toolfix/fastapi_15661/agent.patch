@@ -0,0 +1,24 @@
+import argparse
+import subprocess
+import sys
+from pathlib import Path
+import re
+
+def main():
+    parser = argparse.ArgumentParser(description="Prepare release")
+    parser.add_argument("version", help="The version to set")
+    args = parser.parse_args()
+
+    # Update version in fastapi/__init__.py
+    init_file = Path("fastapi/__init__.py")
+    content = init_file.read_text()
+    new_content = re.sub(r'__version__ = ".*"', f'__version__ = "{args.version}"', content)
+    init_file.write_text(new_content)
+    print(f"Updated version to {args.version} in {init_file}")
+
+    # Run add_latest_release_date.py
+    subprocess.run([sys.executable, "scripts/add_latest_release_date.py"], check=True)
+    print("Updated release notes date")
+
+if __name__ == "__main__":
+    main()
