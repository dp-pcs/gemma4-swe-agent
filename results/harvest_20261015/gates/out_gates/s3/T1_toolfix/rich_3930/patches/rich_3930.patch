+def graphemes(text: str) -> Iterable[str]:
+    """Split text into graphemes."""
+    if not text:
+        return
+
+    current_grapheme = []
+    for char in text:
+        if not current_grapheme:
+            current_grapheme.append(char)
+        elif unicodedata.category(char).startswith("M") or char == "\u200d" or "\uFE00" <= char <= "\uFE0F":
+            current_grapheme.append(char)
+        else:
+            yield "".join(current_grapheme)
+            current_grapheme = [char]
+    if current_grapheme:
+        yield "".join(current_grapheme)
