@@ -0,0 +1,40 @@
+import re
+import sys
+import subprocess
+from pathlib import Path
+import argparse
+
+def main():
+    parser = argparse.ArgumentParser(description="Prepare a new FastAPI release.")
+    parser.add_argument("version", help="The new version to set (e.g., 0.136.4)")
+    parser.add_argument("--dry-run", action="store_true", help="Do not write changes to files")
+    args = parser.parse_args()
+
+    new_version = args.version
+    init_file = Path("fastapi/__init__.py")
+    content = init_file.read_text()
+
+    # Update __version__ = "..."
+    pattern = r'^__version__ = ".*"$'
+    new_content = re.sub(pattern, f'__version__ = "{new_version}"', content, flags=re.MULTILINE)
+    
+    if new_content == content:
+        print(f"Version {new_version} already set in fastapi/__init__.py")
+    else:
+        if args.dry_run:
+            print(f"[dry-run] Would update fastapi/__init__.py to version {new_version}")
+        else:
+            init_file.write_text(new_content)
+            print(f"Updated fastapi/__init__.py to version {new_version}")
+
+    # Run scripts/add_latest_release_date.py
+    print("Adding latest release date to release notes...")
+    if args.dry_run:
+        print(f"[dry-run] Would run scripts/add_latest_release_date.py")
+    else:
+        subprocess.run([sys.executable, "scripts/add_latest_release_date.py"], check=True)
+
+    print(f"Successfully prepared release {new_version}")
+
+if __name__ == "__main__":
+    main()
