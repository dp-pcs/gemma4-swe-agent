+
+
+
+class SSEResponse(StreamingResponse):
+    def __init__(
+        self,
+        content,
+        status_code: int = 200,
+        headers: dict = None,
+        background: Any = None,
+        media_type: str = "text/event-stream",
+    ):
+        if headers is None:
+            headers = {}
+        headers["Cache-Control"] = "no-cache"
+        headers["Connection"] = "keep-alive"
+        super().__init__(content, status_code, headers, background, media_type)
