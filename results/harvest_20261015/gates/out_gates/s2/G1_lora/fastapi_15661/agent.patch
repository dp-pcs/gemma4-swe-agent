index 000000000..2fe5ef8bb
--- /dev/null
+++ b/scripts/release.py
@@ -0,0 +1,42 @@
+import re
+from datetime import date
+from pathlib import Path
+
+import typer
+
+app = typer.Typer()
+
+VERSION_FILE = Path("fastapi/__init__.py")
+RELEASE_NOTES_FILE = Path("docs/en/docs/release-notes.md")
+
+@app.command()
+def prepare(
+    version: str = typer.Argument(..., help="The new version to release (e.g. 0.137.0)"),
+):
+    """
+    Prepare a new release by updating the version and release notes.
+    """
+    # Update version in fastapi/__init__.py
+    content = VERSION_FILE.read_text(encoding="utf-8")
+    new_content = re.sub(r'__version__ = ".*"', f'__version__ = "{version}"', content)
+    VERSION_FILE.write_text(new_content, encoding="utf-8")
+    typer.echo(f"Updated version to {version} in {VERSION_FILE}")
+
+    # Update release notes
+    content = RELEASE_NOTES_FILE.read_text(encoding="utf-8")
+    today = date.today().isoformat()
+    
+    latest_changes_header = "## Latest Changes"
+    if latest_changes_header not in content:
+        typer.echo(f"Could not find {latest_changes_header} in {RELEASE_NOTES_FILE}")
+        raise typer.Abort()
+    
+    new_header = f"## {version} ({today})"
+    
+    # Replace "## Latest Changes" and any following whitespace with "## Latest Changes\n\n## <version> (<date>)\n\n"
+    new_content = re.sub(r"## Latest Changes\s*", f"## Latest Changes\n\n{new_header}\n\n", content, count=1)
+    RELEASE_NOTES_FILE.write_text(new_content, encoding="utf-8")
+    typer.echo(f"Updated release notes in {RELEASE_NOTES_FILE}")
+
+if __name__ == "__main__":
+    app()
