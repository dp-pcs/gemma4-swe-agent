+import typer
+import re
+import subprocess
+from pathlib import Path
+
+app = typer.Typer()
+
+@app.command()
+def release(version: str):
+    """
+    Prepare a new release.
+    """
+    # 1. Update fastapi/__init__.py
+    init_file = Path("fastapi/__init__.py")
+    content = init_file.read_text()
+    new_content = re.sub(r'__version__ = ".*"', f'__version__ = "{version}"', content)
+    init_file.write_text(new_content)
+    print(f"Updated fastapi/__init__.py to version {version}")
+
+    # 2. Update release notes
+    release_notes_file = Path("docs/en/docs/release-notes.md")
+    content = release_notes_file.read_text()
+    
+    # Find the first version header
+    version_header_match = re.search(r"^## (\d+\.\d+\.\d+)", content, re.MULTILINE)
+    if not version_header_match:
+        print("No version header found in release notes")
+        return
+
+    version_header_start = version_header_match.start()
+    
+    # Find the "Latest Changes" section
+    latest_changes_match = re.search(r"^## Latest Changes\n(.*?)(?=\n## \d+\.\d+\.\d+)", content, re.DOTALL | re.MULTILINE)
+    if not latest_changes_match:
+        print("No 'Latest Changes' section found in release notes")
+        return
+
+    latest_changes_content = latest_changes_match.group(1)
+    
+    # Construct the new content
+    before_latest = content[:latest_changes_match.start()]
+    new_version_section = f"## {version}\n{latest_changes_content}\n"
+    after_latest = content[version_header_start:]
+    
+    final_content = before_latest + new_version_section + after_latest
+    release_notes_file.write_text(final_content)
+    print(f"Updated release notes with version {version}")
+
+    # 3. Run add_latest_release_date.py
+    subprocess.run(["python3", "scripts/add_latest_release_date.py"], check=True)
+    print("Updated release date in release notes")
+
+if __name__ == "__main__":
+    app()
