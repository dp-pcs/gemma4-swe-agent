+def iter_graphemes(text: str) -> Iterable[str]:
+    """Yield graphemes from the text.
+
+    A grapheme is a sequence of codepoints that produce a single glyph
+    in the terminal.
+    """
+    if not text:
+        return
+
+    grapheme = []
+    for char in text:
+        if get_character_cell_size(char) == 0 and grapheme:
+            grapheme.append(char)
+        else:
+            if grapheme:
+                yield "".join(grapheme)
+            grapheme = [char]
+    if grapheme:
+        yield "".join(grapheme)
