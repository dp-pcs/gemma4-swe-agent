+"""Prepare a new release by bumping the version and updating release notes."""
+
+import argparse
+import re
+import sys
+from pathlib import Path
+
+VERSION_FILE = Path("fastapi/__init__.py")
+RELEASE_NOTES_FILE = Path("docs/en/docs/release-notes.md")
+
+def bump_version(new_version: str) -> None:
+    content = VERSION_FILE.read_text()
+    new_content = re.sub(r'__version__ = ".*"', f'__version__ = "{new_version}"', content)
+    VERSION_FILE.write_text(new_content)
+    print(f"Updated version to {new_version} in {VERSION_FILE}")
+
+def update_release_notes(new_version: str) -> None:
+    content = RELEASE_NOTES_FILE.read_text()
+    # Find the position of the first version header (## 0.x.x)
+    match = re.search(r'^## \d+\.\d+\.\d+', content, re.MULTILINE)
+    if match:
+        start = match.start()
+        # Insert the new version header before the first version header
+        # We keep the "## Latest Changes" section and its content
+        # The version headers start after "## Latest Changes" and its content.
+        # Actually, the structure is:
+        # ## Latest Changes
+        # ...
+        # ## 0.136.3 (2026-05-23)
+        # ...
+        # So we insert the new version header before the first version header.
+        new_header = f"## {new_version}\n\n"
+        updated_content = content[:start] + new_header + content[start:]
+        RELEASE_NOTES_FILE.write_text(updated_content)
+        print(f"Added {new_version} header to {RELEASE_NOTES_FILE}")
+    else:
+        # If no version header is found, just append it to the end
+        with open(RELEASE_NOTES_FILE, "a") as f:
+            f.write(f"\n## {new_version}\n\n")
+        print(f"Added {new_version} header to the end of {RELEASE_NOTES_FILE}")
+
+def main() -> None:
+    parser = argparse.ArgumentParser(description="Prepare a new release.")
+    parser.add_argument("version", help="The new version to set (e.g. 0.137.0)")
+    args = parser.parse_args()
+
+    bump_version(args.version)
+    update_release_notes(args.version)
+
+if __name__ == "__main__":
+    main()
