+"""Script to prepare for a release."""
+
+import subprocess
+import sys
+from pathlib import Path
+
+def run_command(command: list[str]):
+    print(f"Running: {' '.join(command)}")
+    result = subprocess.run(command, capture_output=True, text=True)
+    if result.returncode != 0:
+        print(f"Error: {result.stderr}")
+        sys.exit(result.returncode)
+    return result.stdout
+
+def main() -> None:
+    # 1. Check if on master branch
+    branch = run_command(["git", "rev-parse", "--abbrev-ref", "HEAD"]).strip()
+    if branch != "master":
+        print(f"Error: Must be on master branch, currently on {branch}")
+        sys.exit(1)
+
+    # 2. Check if working tree is clean
+    status = run_command(["git", "status", "--porcelain"]).strip()
+    if status:
+        print("Error: Working tree is not clean")
+        sys.exit(1)
+
+    # 3. Run lint.sh
+    run_command(["./scripts/lint.sh"])
+
+    # 4. Run add_latest_release_date.py
+    run_command([sys.executable, "scripts/add_latest_release_date.py"])
+
+    # 5. Run tests
+    run_command(["./scripts/test.sh"])
+
+    print("Release preparation complete!")
+
+if __name__ == "__main__":
+    main()
