+def split_graphemes(text: str) -> list[str]:
+    """Split text into graphemes."""
+    graphemes = []
+    if not text:
+        return graphemes
+
+    current_grapheme = ""
+    for i, char in enumerate(text):
+        is_continuation = (
+            unicodedata.combining(char) > 0 or
+            char == "‍" or
+            "ἿB" <= char <= "ἿF" or
+            char == "️"
+        )
+
+        prev_was_zwj = (i > 0 and text[i - 1] == "‍")
+
+        if is_continuation or prev_was_zwj:
+            current_grapheme += char
+        else:
+            if current_grapheme:
+                graphemes.append(current_grapheme)
+            current_grapheme = char
+
+    if current_grapheme:
+        graphemes.append(current_grapheme)
+    return graphemes
+
+
+def get_grapheme_cell_size(grapheme: str) -> int:
+    """Get the cell size of a grapheme."""
+    if not grapheme:
+        return 0
+    return get_character_cell_size(grapheme[0])
+
 
 
