+if sys.version_info >= (3, 13):  # pragma: no cover
+    from inspect import iscoroutinefunction
+else:  # pragma: no cover
+    from asyncio import iscoroutinefunction
+
+
+def _unwrapped_chain(func: Any):
+    current = func
+    yield current
+    while True:
+        if hasattr(current, "__wrapped__"):
+            current = current.__wrapped__
+            yield current
+            continue
+        if isinstance(current, partial):
+            current = current.func
+            yield current
+            continue
+        break
+
+
+def is_async_callable(func: Any) -> bool:
+    for f in _unwrapped_chain(func):
+        if iscoroutinefunction(f):
+            return True
+        if not inspect.isroutine(f) and not inspect.isclass(f):
+            dunder_call = getattr(f, "__call__", None)
+            if dunder_call and iscoroutinefunction(dunder_call):
+                return True
+    return False
+
+
+def is_gen_callable(func: Any) -> bool:
+    for f in _unwrapped_chain(func):
+        if inspect.isgeneratorfunction(f):
+            return True
+        if not inspect.isroutine(f) and not inspect.isclass(f):
+            dunder_call = getattr(f, "__call__", None)
+            if dunder_call and inspect.isgeneratorfunction(dunder_call):
+                return True
+    return False
+
+
+def is_async_gen_callable(func: Any) -> bool:
+    for f in _unwrapped_chain(func):
