+def iter_graphemes(text: str):
+    """Iterate over the graphemes in the text."""
+    if not text:
+        return
+
+    grapheme = ""
+    for char in text:
+        if grapheme == "":
+            grapheme = char
+        elif unicodedata.combining(char) > 0 or char == "\u200d":
+            grapheme += char
+        elif grapheme[-1] == "\u200d":
+            grapheme += char
+        else:
+            yield grapheme
+            grapheme = char
+    if grapheme:
+        yield grapheme
+
+
+def get_grapheme_cell_size(grapheme: str) -> int:
+    """Get the cell size of a grapheme."""
+    if not grapheme:
+        return 0
+    return get_character_cell_size(grapheme[0])
