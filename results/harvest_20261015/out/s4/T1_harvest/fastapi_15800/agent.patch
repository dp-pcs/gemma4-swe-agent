+    def frontend(
+        self,
+        path: str,
+        directory: str,
+        name: str = "frontend",
+    ) -> None:
+        """
+        Mount a static directory to serve as the frontend.
+
+        ## Example
+
+        ```python
+        from fastapi import FastAPI
+
+        app = FastAPI()
+        app.frontend("/", directory="dist")
