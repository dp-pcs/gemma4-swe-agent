@@ -0,0 +1,46 @@
+"""Prepare for a new release by updating the version and release notes."""
+
+import re
+import subprocess
+import sys
+from pathlib import Path
+
+VERSION_FILE = Path("fastapi/__init__.py")
+RELEASE_NOTES_FILE = Path("docs/en/docs/release-notes.md")
+
+def main() -> None:
+    if len(sys.argv) != 2:
+        print("Usage: python scripts/prepare_release.py <version>")
+        sys.exit(1)
+
+    new_version = sys.argv[1]
+
+    # 1. Update version in fastapi/__init__.py
+    content = VERSION_FILE.read_text()
+    new_content = re.sub(
+        r'^__version__ = ".*"', f'__version__ = "{new_version}"', content, flags=re.MULTILINE
+    )
+    VERSION_FILE.write_text(new_content)
+    print(f"Updated version to {new_version} in {VERSION_FILE}")
+
+    # 2. Update Latest Changes to version in release-notes.md
+    content = RELEASE_NOTES_FILE.read_text()
+    if "## Latest Changes" not in content:
+        print("Error: '## Latest Changes' header not found in release notes")
+        sys.exit(1)
+
+    new_content = content.replace("## Latest Changes", f"## {new_version}", 1)
+    RELEASE_NOTES_FILE.write_text(new_content)
+    print(f"Updated '## Latest Changes' to '## {new_version}' in {RELEASE_NOTES_FILE}")
+
+    # 3. Add date to the new version header
+    # Call scripts/add_latest_release_date.py
+    result = subprocess.run([sys.executable, "scripts/add_latest_release_date.py"])
+    if result.returncode != 0:
+        print("Error: Failed to add release date")
+        sys.exit(result.returncode)
+
+    print("Release preparation complete!")
+
+if __name__ == "__main__":
+    main()
