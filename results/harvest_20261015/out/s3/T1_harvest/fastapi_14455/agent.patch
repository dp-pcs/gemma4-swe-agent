diff --git a/fastapi/openapi/utils.py b/fastapi/openapi/utils.py
index dbc93d28..b8e74f0b 100644
--- a/fastapi/openapi/utils.py
+++ b/fastapi/openapi/utils.py
@@ -87,7 +87,26 @@ def get_openapi_security_definitions(
             exclude_none=True,
         )
         security_name = security_requirement.security_scheme.scheme_name
-        security_definitions[security_name] = security_definition
+        if (
+            security_name in security_definitions
+            and security_definitions[security_name].get("type") == "oauth2"
+            and security_definition.get("type") == "oauth2"
+        ):
+            existing_flows = security_definitions[security_name].get("flows", {})
+            new_flows = security_definition.get("flows", {})
+            for flow_type, flow_details in new_flows.items():
+                if flow_type in existing_flows:
+                    existing_scopes = existing_flows[flow_type].get("scopes", [])
+                    new_scopes = flow_details.get("scopes", [])
+                    merged_scopes = existing_scopes + [
