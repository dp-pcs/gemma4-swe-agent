+++ b/scripts/prepare_release.py
@@ -0,0 +1,45 @@
+"""Prepare for a new release by updating the version and release notes."""
+
+import re
+import sys
+import subprocess
+from pathlib import Path
+
+VERSION_FILE = Path("fastapi/__init__.py")
+RELEASE_NOTES_FILE = Path("docs/en/docs/release-notes.md")
+
+def main() -> None:
+    if len(sys.argv) != 2:
+        print("Usage: python scripts/prepare_release.py <version>")
+        sys.exit(1)
+
+    new_version = sys.argv[1]
+
+    # Update version in fastapi/__init__.py
+    content = VERSION_FILE.read_text()
+    new_content = re.sub(r'__version__ = ".*"', f'__version__ = "{new_version}"', content)
+    VERSION_FILE.write_text(new_content)
+    print(f"Updated {VERSION_FILE} to {new_version}")
+
+    # Update release notes
+    lines = RELEASE_NOTES_FILE.read_text().splitlines(keepends=True)
+    found = False
+    for i, line in enumerate(lines):
+        if line.strip() == "## Latest Changes":
+            lines[i] = f"## {new_version}\n"
+            found = True
+            break
+
+    if not found:
+        print("Could not find '## Latest Changes' in release notes")
+        sys.exit(1)
+
+    RELEASE_NOTES_FILE.write_text("".join(lines))
+    print(f"Updated {RELEASE_NOTES_FILE} with version {new_version}")
+
+    # Add date to release notes
+    subprocess.run([sys.executable, "scripts/add_latest_release_date.py"], check=True)
+    print("Added date to release notes")
+
+if __name__ == "__main__":
+    main()
