+def split_graphemes(text: str) -> list[str]:
+    """Split a string into a list of graphemes."""
+    graphemes = []
+    if not text:
+        return graphemes
+
+    current_grapheme = ""
+    for char in text:
+        if current_grapheme and get_character_cell_size(char) == 0:
+            current_grapheme += char
+        elif current_grapheme.endswith("‍"):
+            current_grapheme += char
+        else:
+            if current_grapheme:
+                graphemes.append(current_grapheme)
+            current_grapheme = char
+    if current_grapheme:
+        graphemes.append(current_grapheme)
+    return graphemes
+
