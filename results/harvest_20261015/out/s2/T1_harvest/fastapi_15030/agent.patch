diff --git a/fastapi/responses.py b/fastapi/responses.py
index 5b1154c0..4a21acd7 100644
--- a/fastapi/responses.py
+++ b/fastapi/responses.py
@@ -82,3 +82,21 @@ class ORJSONResponse(JSONResponse):
         return orjson.dumps(
             content, option=orjson.OPT_NON_STR_KEYS | orjson.OPT_SERIALIZE_NUMPY
         )
+
+class SSEResponse(StreamingResponse):
+    """
+    Response class for Server-Sent Events (SSE).
+    """
+    def __init__(
+        self,
+        content: Any,
+        status_code: int = 200,
+        headers: Any = None,
+        background: Any = None,
+        media_type: str = "text/event-stream",
+    ):
+        if headers is None:
+            headers = {}
+        headers.setdefault("Cache-Control", "no-cache")
+        headers.setdefault("Connection", "keep-alive")
+        super().__init__(content, status_code=status_code, headers=headers, background=background, media_type=media_type)
