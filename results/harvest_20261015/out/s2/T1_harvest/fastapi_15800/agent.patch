diff --git a/fastapi/staticfiles.py b/fastapi/staticfiles.py
index 299015d4f..ba41b0c8d 100644
--- a/fastapi/staticfiles.py
+++ b/fastapi/staticfiles.py
@@ -1 +1,9 @@
 from starlette.staticfiles import StaticFiles as StaticFiles  # noqa
+
+class SPAStaticFiles(StaticFiles):
+    def get_response(self, path: str, scope):
+        response = super().get_response(path, scope)
+        if response.status_code == 404:
+            return super().get_response("index.html", scope)
+        return response
+
