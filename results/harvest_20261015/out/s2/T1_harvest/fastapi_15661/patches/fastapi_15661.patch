@@ -0,0 +1,31 @@
+import subprocess
+import sys
+import typer
+from pathlib import Path
+import re
+
+app = typer.Typer()
+
+@app.command()
+def main(version: str):
+    """
+    Prepare the release for the given version.
+    """
+    # 1. Update version in fastapi/__init__.py
+    init_file = Path("fastapi/__init__.py")
+    content = init_file.read_text()
+    new_content = re.sub(r'__version__ = ".*"', f'__version__ = "{version}"', content)
+    init_file.write_text(new_content)
+    typer.echo(f"Updated version to {version} in fastapi/__init__.py")
+
+    # 2. Add release date to release notes
+    subprocess.run([sys.executable, "scripts/add_latest_release_date.py"], check=True)
+    typer.echo("Updated release date in release notes")
+
+    # 3. Run linting and formatting
+    subprocess.run(["bash", "scripts/lint.sh"], check=True)
+    subprocess.run(["bash", "scripts/format.sh"], check=True)
+    typer.echo("Ran linting and formatting")
+
+if __name__ == "__main__":
+    app()
