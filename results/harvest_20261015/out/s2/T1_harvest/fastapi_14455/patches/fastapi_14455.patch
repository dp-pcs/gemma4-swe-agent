+def _merge_security_schemes(
+    existing_schemes: Dict[str, Any],
+    new_schemes: Dict[str, Any],
+) -> None:
+    for name, definition in new_schemes.items():
+        if name in existing_schemes:
+            existing_definition = existing_schemes[name]
+            if (
+                existing_definition.get("type") == "oauth2"
+                and definition.get("type") == "oauth2"
+            ):
+                existing_flows = existing_definition.setdefault("flows", {})
+                new_flows = definition.get("flows", {})
+                for flow_name, flow_data in new_flows.items():
+                    if flow_name in existing_flows:
+                        existing_flow = existing_flows[flow_name]
+                        if isinstance(existing_flow, dict):
+                            existing_scopes = existing_flow.setdefault("scopes", {})
+                            new_scopes = flow_data.get("scopes", {})
+                            if isinstance(new_scopes, dict):
+                                existing_scopes.update(new_scopes)
+                    else:
+                        existing_flows[flow_name] = flow_data
+            else:
+                existing_schemes[name] = definition
+        else:
+            existing_schemes[name] = definition
+
+
