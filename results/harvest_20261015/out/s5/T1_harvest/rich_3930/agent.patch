+def split_graphemes(text: str) -> list[str]:
+    """Split text into graphemes."""
+    graphemes = []
+    if not text:
+        return graphemes
+
+    start = 0
+    for i in range(1, len(text)):
+        char = text[i]
+        prev_char = text[i-1]
+
+        if get_character_cell_size(char) > 0 and prev_char != "\u200d":
+            graphemes.append(text[start:i])
+            start = i
+
+    graphemes.append(text[start:])
+    return graphemes
+
