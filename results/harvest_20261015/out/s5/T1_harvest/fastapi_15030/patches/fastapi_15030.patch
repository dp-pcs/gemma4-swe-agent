@@ -1,4 +1,5 @@
-from typing import Any
+from typing import Any, AsyncGenerator, Iterable, Union
+import json
 
 from fastapi.exceptions import FastAPIDeprecationWarning
 from starlette.responses import FileResponse as FileResponse  # noqa
@@ -82,3 +83,51 @@ class ORJSONResponse(JSONResponse):
         return orjson.dumps(
             content, option=orjson.OPT_NON_STR_KEYS | orjson.OPT_SERIALIZE_NUMPY
         )
+
+def _format_sse_item(item: Any) -> bytes:
+    if isinstance(item, str):
+        return f"data: {item}\n\n".encode("utf-8")
+    if isinstance(item, dict):
+        lines = []
+        if "event" in item:
+            lines.append(f"event: {item['event']}")
+        if "data" in item:
+            data = item["data"]
+            if not isinstance(data, str):
+                data = json.dumps(data)
+            lines.append(f"data: {data}")
+        if "id" in item:
+            lines.append(f"id: {item['id']}")
+        if "retry" in item:
+            lines.append(f"retry: {item['retry']}")
+        return ("\n".join(lines) + "\n\n").encode("utf-8")
+    return f"data: {item}\n\n".encode("utf-8")
+
+class EventSourceResponse(StreamingResponse):
+    def __init__(
+        self,
+        content: Union[AsyncGenerator, Iterable],
+        status_code: int = 200,
+        headers: dict = None,
+        background: Any = None,
+    ):
+        if headers is None:
+            headers = {}
+        headers["Cache-Control"] = "no-cache"
+        headers["Connection"] = "keep-alive"
+        
+        async def sse_generator():
+            if hasattr(content, "__aiter__"):
+                async for item in content:
+                    yield _format_sse_item(item)
+            else:
+                for item in content:
+                    yield _format_sse_item(item)
+
+        super().__init__(
+            sse_generator(),
+            media_type="text/event-stream",
+            status_code=status_code,
+            headers=headers,
+            background=background,
+        )
