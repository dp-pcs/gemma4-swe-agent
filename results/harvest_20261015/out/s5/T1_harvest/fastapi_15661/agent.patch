diff --git a/scripts/release.py b/scripts/release.py
new file mode 100644
index 000000000..a0f9199d5
--- /dev/null
+++ b/scripts/release.py
@@ -0,0 +1,36 @@
+import subprocess
+import sys
+
+def main():
+    scripts = [
+        "scripts/add_latest_release_date.py",
+        "scripts/contributors.py",
+        "scripts/people.py",
+        "scripts/sponsors.py",
+    ]
+    
+    # Setup git user
+    subprocess.run(["git", "config", "user.name", "github-actions[bot]"], check=True)
+    subprocess.run(
+        ["git", "config", "user.email", "github-actions[bot]@users.noreply.github.com"],
+        check=True,
+    )
+    
+    # Create a branch for release preparation
+    branch_name = "release-preparation"
+    subprocess.run(["git", "checkout", "-b", branch_name], check=True)
+    
+    for script in scripts:
+        print(f"Running {script}...")
+        args = ["uv", "run", "python", script]
+        if script != "scripts/add_latest_release_date.py":
+            args.append("--no-pr")
+        subprocess.run(args, check=True)
+        
+    subprocess.run(["git", "add", "."], check=True)
+    subprocess.run(["git", "commit", "-m", "chore: release preparation"], check=True)
+    subprocess.run(["git", "push", "origin", branch_name], check=True)
+    print(f"Release preparation complete. Branch {branch_name} pushed.")
+
+if __name__ == "__main__":
+    main()
