+def split_graphemes(text: str) -> list[str]:
+    """Split a string into a list of graphemes."""
+    if not text:
+        return []
+
+    graphemes: list[str] = []
+    current_grapheme = ""
+
+    for i, char in enumerate(text):
+        if i == 0:
+            current_grapheme = char
+            continue
+
+        prev_char = text[i - 1]
+        if not unicodedata.category(char).startswith("M") and char != "\u200d" and prev_char != "\u200d":
+            graphemes.append(current_grapheme)
+            current_grapheme = char
+        else:
+            current_grapheme += char
+
+    graphemes.append(current_grapheme)
+    return graphemes
+
 
 
