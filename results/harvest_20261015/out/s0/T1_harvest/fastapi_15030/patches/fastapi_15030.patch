@@ -10,6 +10,36 @@ from starlette.responses import Response as Response  # noqa
 from starlette.responses import StreamingResponse as StreamingResponse  # noqa
 from typing_extensions import deprecated
 
+
+class SSEResponse(StreamingResponse):
+    """SSE response.
+
+    **Note**: `SSEResponse` is a subclass of `StreamingResponse` that sets the
+    `Content-Type` header to `text/event-stream`, and also sets `Cache-Control`
+    to `no-cache` and `Connection` to `keep-alive`.
+    """
+
+    def __init__(
+        self,
+        content: Any,
+        status_code: int = 200,
+        headers: dict[str, str] | None = None,
+        background: Any = None,
+    ):
+        if headers is None:
+            headers = {}
+        else:
+            headers = headers.copy()
+        headers["Cache-Control"] = "no-cache"
+        headers["Connection"] = "keep-alive"
+        super().__init__(
+            content=content,
+            status_code=status_code,
+            headers=headers,
+            background=background,
+            media_type="text/event-stream",
+        )
+
