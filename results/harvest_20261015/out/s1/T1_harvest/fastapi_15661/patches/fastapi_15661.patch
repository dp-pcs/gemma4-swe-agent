+import typer
+import re
+from pathlib import Path
+import subprocess
+import sys
+
+app = typer.Typer()
+
+@app.command()
+def main(version: str):
+    """
+    Prepare release by updating version in __init__.py and release-notes.md,
+    and adding the latest release date.
+    """
+    # 1. Update fastapi/__init__.py
+    init_file = Path("fastapi/__init__.py")
+    content = init_file.read_text()
+    new_content = re.sub(r'__version__ = ".*"', f'__version__ = "{version}"', content)
+    init_file.write_text(new_content)
+    typer.echo(f"Updated version to {version} in {init_file}")
+    
+    # 2. Update docs/en/docs/release-notes.md
+    release_notes_file = Path("docs/en/docs/release-notes.md")
+    content = release_notes_file.read_text()
+    
+    # Find the first version header
+    match = re.search(r'^## \d+\.\d+\.\d+', content, re.MULTILINE)
+    if match:
+        start = match.start()
+        new_content = content[:start] + f"## {version}\n\n" + content[start:]
+        release_notes_file.write_text(new_content)
+        typer.echo(f"Added {version} header to {release_notes_file}")
+    else:
+        typer.echo("No version header found in release notes. Adding to the end.")
+        release_notes_file.write_text(content + f"\n\n## {version}\n\n")
+    
+    # 3. Run scripts/add_latest_release_date.py
+    typer.echo("Running add_latest_release_date.py...")
+    subprocess.run([sys.executable, "scripts/add_latest_release_date.py"], check=True)
+    typer.echo("Done!")
+
+if __name__ == "__main__":
+    app()
