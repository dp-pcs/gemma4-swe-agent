+
+        # Consume ZWJ sequences
+        while i + 1 < len(text) and text[i] == "\u200d":
+            i += 2 # ZWJ + next character
+            # Also consume combining characters and variation selectors after the next character
+            while i < len(text) and (unicodedata.combining(text[i]) or 0xFE00 <= ord(text[i]) <= 0xFE0F):
+                i += 1
+
+        yield text[start:i]
+
 
 
