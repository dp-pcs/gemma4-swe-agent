+def iter_cells(text: str):
+    """Split text into sequences that produce a single glyph in the terminal."""
+    if not text:
+        return
+
+    i = 0
+    while i < len(text):
+        char = text[i]
+        start = i
+        i += 1
+        # Consume combining characters and variation selectors
+        while i < len(text) and (unicodedata.combining(text[i]) or 0xFE00 <= ord(text[i]) <= 0xFE0F):
