+import sys
+import re
+import subprocess
+from pathlib import Path
+
+def main():
+    if len(sys.argv) != 2:
+        print("Usage: python scripts/prepare_release.py <version>")
+        sys.exit(1)
+    
+    new_version = sys.argv[1]
+    
+    # Update fastapi/__init__.py
+    init_file = Path("fastapi/__init__.py")
+    content = init_file.read_text()
+    new_content = re.sub(r'__version__ = ".*"', f'__version__ = "{new_version}"', content)
+    init_file.write_text(new_content)
+    print(f"Updated fastapi/__init__.py to version {new_version}")
+    
+    # Update docs/en/docs/release-notes.md
+    release_notes_file = Path("docs/en/docs/release-notes.md")
+    content = release_notes_file.read_text()
+    
+    # Find the first version header (e.g., ## 0.136.3)
+    match = re.search(r'^## \d+\.\d+\.\d+', content, re.MULTILINE)
+    if match:
+        start = match.start()
+        # Insert the new version header before the first existing version header
+        new_content = content[:start] + f"## {new_version}\n\n" + content[start:]
+    else:
+        # If no version header is found, append to the end
+        new_content = content + f"\n\n## {new_version}\n"
+        
+    release_notes_file.write_text(new_content)
+    print(f"Added {new_version} to release notes")
+    
+    # Run scripts/add_latest_release_date.py
+    print("Running scripts/add_latest_release_date.py...")
+    subprocess.run([sys.executable, "scripts/add_latest_release_date.py"], check=True)
+    print("Done!")
+
+if __name__ == "__main__":
+    main()
