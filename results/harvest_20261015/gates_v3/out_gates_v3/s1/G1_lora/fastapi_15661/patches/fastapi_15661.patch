@@ -0,0 +1,49 @@
+import argparse
+from datetime import date
+from pathlib import Path
+import sys
+
+def prepare_release(version: str):
+    file_path = Path('docs/en/docs/release-notes.md')
+    if not file_path.exists():
+        print(f'Error: {file_path} not found')
+        sys.exit(1)
+
+    content = file_path.read_text()
+
+    # Find the Latest Changes section
+    latest_changes_marker = '## Latest Changes'
+    latest_changes_start = content.find(latest_changes_marker)
+    if latest_changes_start == -1:
+        print(f'Error: {latest_changes_marker} section not found')
+        sys.exit(1)
+
+    # Find the end of the Latest Changes section (start of the next ## header)
+    next_header_start = content.find('\n## ', latest_changes_start + len(latest_changes_marker))
+
+    if next_header_start == -1:
+        # Latest Changes is the last section
+        latest_changes_content = content[latest_changes_start + len(latest_changes_marker):].strip()
+        new_content = (
+            content[: latest_changes_start + len(latest_changes_marker)]
+            + f'\n\n## {version} ({date.today().isoformat()})\n\n'
+            + latest_changes_content
+        )
+    else:
+        latest_changes_content = content[latest_changes_start + len(latest_changes_marker):next_header_start].strip()
+        new_content = (
+            content[: latest_changes_start + len(latest_changes_marker)]
+            + f'\n\n## {version} ({date.today().isoformat()})\n\n'
+            + latest_changes_content
+            + '\n\n'
+            + content[next_header_start:]
+        )
+
+    file_path.write_text(new_content)
+    print(f'Successfully prepared release {version}')
+
+if __name__ == '__main__':
+    parser = argparse.ArgumentParser(description='Prepare release notes')
+    parser.add_argument('version', help='The version number for the release')
+    args = parser.parse_args()
+    prepare_release(args.version)
