diff --git a/scripts/prepare_release.py b/scripts/prepare_release.py
new file mode 100644
index 000000000..2861c48be
--- /dev/null
+++ b/scripts/prepare_release.py
@@ -0,0 +1,20 @@
+import subprocess
+import sys
+
+def main():
+    scripts = [
+        "scripts/contributors.py",
+        "scripts/people.py",
+        "scripts/sponsors.py",
+        "scripts/add_latest_release_date.py",
+    ]
+    for script in scripts:
+        print(f"Running {script}...")
+        result = subprocess.run([sys.executable, script])
+        if result.returncode != 0:
+            print(f"Error running {script}")
+            sys.exit(result.returncode)
+    print("All release preparation scripts completed successfully!")
+
+if __name__ == "__main__":
+    main()
