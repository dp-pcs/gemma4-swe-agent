+class EventSourceResponse(StreamingResponse):
+    """
+    SSE response.
+    """
+    def __init__(
+        self,
+        content,
+        status_code: int = 200,
+        headers: Any = None,
+        background: Any = None,
+        media_type: str = "text/event-stream",
+    ) -> None:
+        if headers is None:
+            headers = {}
+        headers["Cache-Control"] = "no-cache"
+        headers["Connection"] = "keep-alive"
+        headers["Content-Type"] = media_type
+        super().__init__(content, status_code=status_code, headers=headers, background=background, media_type=media_type)
