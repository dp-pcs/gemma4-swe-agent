+import sys
+import pathlib
+import re
+import os
+
+# Add the current directory to sys.path to allow importing from scripts
+sys.path.append(os.path.dirname(os.path.abspath(__file__)))
+
+try:
+    from add_latest_release_date import add_latest_release_date
+except ImportError:
+    # Fallback for different execution environments
+    try:
+        from scripts.add_latest_release_date import add_latest_release_date
+    except ImportError:
+        print("Could not import add_latest_release_date. Skipping date update.")
+        add_latest_release_date = lambda: None
+
+def update_version(version: str):
+    # Update fastapi/__init__.py
+    init_file = pathlib.Path("fastapi/__init__.py")
+    content = init_file.read_text()
+    new_content = re.sub(r'__version__ = ".*"', f'__version__ = "{version}"', content)
+    init_file.write_text(new_content)
+    print(f"Updated fastapi/__init__.py to version {version}")
+
+    # Update docs/en/docs/release-notes.md
+    release_notes_file = pathlib.Path("docs/en/docs/release-notes.md")
+    content = release_notes_file.read_text()
+    
+    latest_changes_marker = "## Latest Changes"
+    latest_changes_start = content.find(latest_changes_marker)
+    if latest_changes_start == -1:
+        print("Could not find '## Latest Changes' in release notes.")
+        return
+
+    # Find the first version header after "## Latest Changes"
+    # Version headers are like "## 0.136.3"
+    version_header_match = re.search(r"## \d+\.\d+\.\d+", content[latest_changes_start:])
+    if not version_header_match:
+        print("Could not find any version header in release notes.")
+        return
+
+    first_version_header_start = latest_changes_start + version_header_match.start()
+    
+    # Extract the content under "## Latest Changes"
+    # It's from the end of the "## Latest Changes" line to the start of the first version header.
+    latest_changes_line_end = content.find("\n", latest_changes_start) + 1
+    
+    latest_changes_content = content[latest_changes_line_end:first_version_header_start].strip()
+    
+    # Now we construct the new content.
+    # 1. Keep everything up to "## Latest Changes" line end.
+    # 2. Insert the new version header.
+    # 3. Insert the latest changes content.
+    # 4. Keep everything from the first version header onwards.
+    
+    new_release_notes_content = (
+        content[:latest_changes_line_end] +
+        f"## {version}\n\n" +
+        latest_changes_content +
+        "\n\n" +
+        content[first_version_header_start:]
+    )
+    
+    release_notes_file.write_text(new_release_notes_content)
+    print(f"Updated docs/en/docs/release-notes.md with version {version}")
+
+if __name__ == "__main__":
+    if len(sys.argv) != 2:
+        print("Usage: python scripts/release.py <version>")
+        sys.exit(1)
+    
+    new_version = sys.argv[1]
+    update_version(new_version)
+    add_latest_release_date()
