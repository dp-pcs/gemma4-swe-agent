+import argparse
+import re
+import sys
+from pathlib import Path
+
+def main():
+    parser = argparse.ArgumentParser(description="Automate release preparation")
+    parser.add_argument("version", help="The new version to set (e.g., 0.137.0)")
+    args = parser.parse_args()
+    
+    version = args.version
+    
+    # 1. Update fastapi/__init__.py
+    init_file = Path("fastapi/__init__.py")
+    if not init_file.exists():
+        print(f"Error: {init_file} not found")
+        sys.exit(1)
+        
+    content = init_file.read_text()
+    if "__version__ =" not in content:
+        print(f"Error: Could not find __version__ in {init_file}")
+        sys.exit(1)
+        
+    new_content = re.sub(r'__version__ = ".*"', f'__version__ = "{version}"', content)
+    init_file.write_text(new_content)
+    print(f"Updated version to {version} in {init_file}")
+    
+    # 2. Update docs/en/docs/release-notes.md
+    release_notes_file = Path("docs/en/docs/release-notes.md")
+    if not release_notes_file.exists():
+        print(f"Error: {release_notes_file} not found")
+        sys.exit(1)
+        
+    content = release_notes_file.read_text()
+    
+    if f"## {version}" in content:
+        print(f"Version {version} already exists in release notes")
+    else:
+        # Find "## Latest Changes" and insert after it.
+        pattern = r"(## Latest Changes\n+)"
+        if not re.search(pattern, content):
+            print(f"Error: Could not find '## Latest Changes' in {release_notes_file}")
+            sys.exit(1)
+            
+        replacement = rf"\1## {version}\n\n"
+        new_content = re.sub(pattern, replacement, content, count=1)
+        release_notes_file.write_text(new_content)
+        print(f"Added version {version} to {release_notes_file}")
+
+if __name__ == "__main__":
+    main()
