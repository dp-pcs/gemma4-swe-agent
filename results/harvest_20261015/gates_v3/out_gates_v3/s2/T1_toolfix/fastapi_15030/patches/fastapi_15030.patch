index 5b1154c0..b56d1d2c 100644
--- a/fastapi/responses.py
+++ b/fastapi/responses.py
@@ -82,3 +82,28 @@ class ORJSONResponse(JSONResponse):
         return orjson.dumps(
             content, option=orjson.OPT_NON_STR_KEYS | orjson.OPT_SERIALIZE_NUMPY
         )
+
+class SSEResponse(StreamingResponse):
+    """SSE response for Server-Sent Events.
+
+    Sets the `Content-Type` to `text/event-stream`, `Cache-Control` to `no-cache`,
+    and `Connection` to `keep-alive`.
+    """
+    def __init__(
+        self,
+        content: Any,
+        status_code: int = 200,
+        headers: dict[str, str] | None = None,
+        background: Any = None,
+        media_type: str = "text/event-stream",
+    ) -> None:
+        if headers is None:
+            headers = {}
+        else:
+            headers = headers.copy()
+        headers["Cache-Control"] = "no-cache"
+        headers["Connection"] = "keep-alive"
+        super().__init__(
+            content, status_code=status_code, headers=headers, background=background, media_type=media_type
+        )
+
